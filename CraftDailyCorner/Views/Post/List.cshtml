@model List<CraftDailyCorner.ViewModels.CreatorPost.VMCreatorPostListItem>

@{
    ViewData["Title"] = "管理日誌";
}

<div class="container py-5" style="max-width:1000px;">

    <!-- 標題列 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">創作日誌管理</h2>
            <p class="text-muted mb-0">管理您發佈的所有日誌</p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            新增日誌
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    尚未建立任何日誌
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:100px;">封面</th>
                                <th>標題</th>
                                <th style="width:120px;">可見性</th>
                                <th style="width:100px;">留言數</th>
                                <th style="width:160px;">更新時間</th>
                                <th style="width:160px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src=@($"/Photos/05CreatorPost/Medium/{item.ImageUrl}.png")
                                             class="rounded"
                                             style="width:80px; height:80px; object-fit:cover;" />
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.Title
                                        </div>
                                        <div class="text-muted small">
                                            建立於 @item.CreatedAt.ToString("yyyy/MM/dd")
                                        </div>
                                    </td>

                                    <td>
                                        @item.Visibility.ToString()
                                    </td>

                                    <td>
                                        @item.CommentCount
                                    </td>

                                    <td>
                                        @item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.PostID"
                                               class="btn btn-sm btn-outline-secondary">
                                                編輯
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.PostID"
                                                  method="post"
                                                  onsubmit="return confirm('確定要刪除嗎？');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    刪除
                                                </button>
                                            </form>
                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>