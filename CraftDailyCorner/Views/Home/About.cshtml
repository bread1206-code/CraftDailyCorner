@{
    ViewData["Title"] = "關於我們";
}

<div class="container py-5" style="max-width: 1100px;">

    <!-- Hero -->
    <section class="mb-5">
        <div class="p-5 p-md-6 rounded-4 shadow-sm border bg-white position-relative overflow-hidden">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="badge rounded-pill text-bg-dark mb-3 px-3 py-2">Academic Project</span>
                    <h1 class="fw-bold display-6 mb-3">CraftDailyCorner</h1>
                    <p class="fs-5 text-secondary mb-3">
                        一個以創作者為核心的創作與電商平台
                    </p>
                    <p class="text-muted mb-4" style="line-height: 1.9;">
                        我們希望打造一個相對自在、低壓的數位空間，
                        讓創作者能透過創作日誌、作品集與商品展示，
                        緩慢而真實地被看見，也讓使用者能從作品與故事中，
                        認識每一位創作者的風格與理念。
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge rounded-pill border text-dark px-3 py-2">創作日誌</span>
                        <span class="badge rounded-pill border text-dark px-3 py-2">作品集展示</span>
                        <span class="badge rounded-pill border text-dark px-3 py-2">商品販售</span>
                        <span class="badge rounded-pill border text-dark px-3 py-2">社群互動</span>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="rounded-4 border bg-light p-4 h-100 shadow-sm">
                        <div class="mb-3">
                            <div class="text-muted small mb-1">平台定位</div>
                            <div class="fw-semibold">創作內容 × 品牌經營 × 電商整合</div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <div class="text-muted small mb-1">核心理念</div>
                            <div class="fw-semibold">讓作品成為理解創作者的入口</div>
                        </div>
                        <hr />
                        <div>
                            <div class="text-muted small mb-1">專題用途</div>
                            <div class="fw-semibold">學術展示與系統實作成果</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 理念 -->
    <section class="mb-5">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 p-md-5">
                        <div class="mb-3">
                            <span class="badge text-bg-light border text-dark px-3 py-2">Project Concept</span>
                        </div>
                        <h3 class="fw-bold mb-3">專題理念</h3>
                        <p class="text-muted mb-3" style="line-height: 1.9;">
                            在現代社群與電子商務平台盛行的時代，
                            許多創作者能透過網路分享作品並販售商品，
                            但並不是每個人都擅長高頻率地曝光自己。
                        </p>
                        <p class="text-muted mb-0" style="line-height: 1.9;">
                            CraftDailyCorner 希望提供一種更溫和的表達方式。
                            創作者不必急著推銷自己，而是透過作品、日誌與品牌頁面，
                            讓他人慢慢理解自己的風格、創作歷程與價值。
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 p-md-5">
                        <div class="mb-3">
                            <span class="badge text-bg-light border text-dark px-3 py-2">Why This Platform</span>
                        </div>
                        <h3 class="fw-bold mb-3">我們想解決什麼</h3>
                        <p class="text-muted mb-3" style="line-height: 1.9;">
                            一般平台往往強調快速曝光與即時互動，
                            但對部分創作者而言，真正能代表自己的，
                            其實是作品背後的故事與長期累積的風格。
                        </p>
                        <p class="text-muted mb-0" style="line-height: 1.9;">
                            因此，本系統整合了創作展示、品牌經營、商品販售與互動功能，
                            讓創作者能在同一個平台中完整呈現自己，
                            也讓使用者從「看見作品」走向「理解創作者」。
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 功能 -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">系統功能</h2>
            <p class="text-muted mb-0">整合創作展示、社群互動與交易流程的完整平台</p>
        </div>

        <div class="row g-4">

            <!-- 創作者 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="icon-box bg-primary-subtle text-primary mb-3">
                            <i class="bi bi-palette-fill"></i>
                        </div>
                        <h5 class="fw-bold">創作者申請與品牌建立</h5>
                        <p class="text-muted mb-0">
                            提供創作者申請流程與品牌資料建立。
                        </p>
                    </div>
                </div>
            </div>

            <!-- 商品 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="icon-box bg-success-subtle text-success mb-3">
                            <i class="bi bi-bag-fill"></i>
                        </div>
                        <h5 class="fw-bold">商品上架與庫存管理</h5>
                        <p class="text-muted mb-0">
                            支援商品建立、分類與庫存管理。
                        </p>
                    </div>
                </div>
            </div>

            <!-- 訂單 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="icon-box bg-warning-subtle text-warning mb-3">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <h5 class="fw-bold">訂單與物流流程</h5>
                        <p class="text-muted mb-0">
                            訂單、付款與出貨完整流程。
                        </p>
                    </div>
                </div>
            </div>

            <!-- 日誌 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="icon-box bg-info-subtle text-info mb-3">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <h5 class="fw-bold">創作日誌與作品集</h5>
                        <p class="text-muted mb-0">
                            累積創作過程與品牌故事。
                        </p>
                    </div>
                </div>
            </div>

            <!-- 社群 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="icon-box bg-danger-subtle text-danger mb-3">
                            <i class="bi bi-chat-dots-fill"></i>
                        </div>
                        <h5 class="fw-bold">社群互動</h5>
                        <p class="text-muted mb-0">
                            留言、按讚與追蹤功能。
                        </p>
                    </div>
                </div>
            </div>

            <!-- 通知 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="icon-box bg-secondary-subtle text-secondary mb-3">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <h5 class="fw-bold">通知與公告</h5>
                        <p class="text-muted mb-0">
                            多類型通知與平台公告整合。
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- 素材與資料來源 -->
    <section class="mb-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white border-0 py-3">
                <h3 class="fw-bold mb-0">資料與素材來源</h3>
            </div>
            <div class="card-body p-4 p-md-5">
                <p class="text-muted mb-4" style="line-height: 1.9;">
                    本系統展示所使用之資料與素材，主要用於專題展示與功能測試，
                    並非真實使用者資料。所有內容皆以學術展示為目的，不作商業用途。
                </p>

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="border rounded-4 h-100 p-4 bg-light">
                            <h5 class="fw-bold mb-3">測試資料</h5>
                            <p class="text-muted mb-0">
                                透過 Seeder 機制自動建立會員、創作者、商品、
                                訂單與社群互動等展示資料。
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-4 h-100 p-4 bg-light">
                            <h5 class="fw-bold mb-3">圖片、音樂素材</h5>
                            <p class="text-muted mb-0">
                                部分圖片由 AI 輔助生成，部分取自免費素材來源，
                                用於系統畫面與展示情境模擬。
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-4 h-100 p-4 bg-light">
                            <h5 class="fw-bold mb-3">文字內容</h5>
                            <p class="text-muted mb-0">
                                部分文案由 AI 協助生成，再經人工調整，
                                以符合品牌風格與展示需求。
                            </p>
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border mt-4 mb-0 rounded-4">
                    <div class="fw-semibold mb-1">聲明</div>
                    <div class="text-muted">
                        本平台為學術專題展示用途，所有資料與素材僅供系統展示與測試，不作商業使用。
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 技術架構 -->
    <section class="mb-3">
        <div class="text-center mb-4">
            <h2 class="fw-bold">技術架構</h2>
            <p class="text-muted mb-0">本專題使用的主要開發技術</p>
        </div>

        <div class="row g-3 justify-content-center">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="border rounded-4 text-center p-3 h-100 bg-white shadow-sm">
                    <div class="fw-bold">ASP.NET Core MVC</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="border rounded-4 text-center p-3 h-100 bg-white shadow-sm">
                    <div class="fw-bold">EF Core</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="border rounded-4 text-center p-3 h-100 bg-white shadow-sm">
                    <div class="fw-bold">SQL Server</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="border rounded-4 text-center p-3 h-100 bg-white shadow-sm">
                    <div class="fw-bold">Bootstrap</div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="border rounded-4 text-center p-3 h-100 bg-white shadow-sm">
                    <div class="fw-bold">AJAX</div>
                </div>
            </div>
        </div>
    </section>

</div>