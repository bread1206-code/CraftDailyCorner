@{
    ViewData["Title"] = "隱私權政策";
}

<div class="container py-5" style="max-width: 1200px;">

    <!-- 頁首 -->
    <div class="rounded-4 shadow-sm border-0 p-4 p-md-5 mb-4"
         style="background: linear-gradient(135deg, #f8f4ee 0%, #fcfaf7 100%);">
        <div class="text-center">
            <span class="badge rounded-pill px-3 py-2 mb-3"
                  style="background-color:#8c6d5a; font-size:0.9rem;">
                平台政策
            </span>
            <h1 class="fw-bold mb-3" style="color:#5c4435;">隱私權政策</h1>
            <p class="text-secondary mb-0 mx-auto" style="max-width: 760px;">
                就像市集中的每一個攤位都重視來訪者的信任，CraftDailyCorner 也重視您的個人資料與隱私。
                以下將以清楚易讀的方式，說明本平台如何蒐集、使用與保護您的資料。
            </p>
        </div>
    </div>

    <div class="row g-4">

        <!-- 左側導覽 -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3" style="color:#5c4435;">政策導覽</h2>
                    <p class="text-muted small mb-3">
                        像逛市集一樣，從左側快速找到你想了解的內容。
                    </p>

                    <div class="d-grid gap-2">
                        <a href="#policy-1" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">01 政策說明</a>
                        <a href="#policy-2" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">02 蒐集的資料類型</a>
                        <a href="#policy-3" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">03 資料蒐集目的</a>
                        <a href="#policy-4" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">04 個人資料利用方式</a>
                        <a href="#policy-5" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">05 資料保存與安全</a>
                        <a href="#policy-6" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">06 Cookie 與相關技術</a>
                        <a href="#policy-7" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">07 使用者權利</a>
                        <a href="#policy-8" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">08 第三方服務</a>
                        <a href="#policy-9" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">09 政策修訂</a>
                        <a href="#policy-10" class="text-decoration-none rounded-3 px-3 py-2"
                           style="background-color:#f8f4ee; color:#5c4435;">10 聯絡我們</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側內容 -->
        <div class="col-lg-9">
            <div class="d-grid gap-4">

                <section id="policy-1" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f3e8dc;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#8c6d5a;color:white;">
                                01
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">政策說明</h2>
                                <p class="text-muted mb-0 small">關於本平台隱私權政策的基本說明</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p class="mb-0">
                            CraftDailyCorner（以下簡稱「本平台」）致力於提供安全、友善的電商與創作者交流服務。
                            為了讓您安心使用本平台各項功能與服務，特此說明本平台如何蒐集、處理、利用及保護您的個人資料。
                            當您使用本平台服務時，即表示您已閱讀、瞭解並同意本隱私權政策之內容。
                        </p>
                    </div>
                </section>

                <section id="policy-2" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#eef3ea;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#6f8b6b;color:white;">
                                02
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">蒐集的資料類型</h2>
                                <p class="text-muted mb-0 small">依功能不同，蒐集的資料也會有所差異</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">
                                    <h3 class="h6 fw-bold mb-2">會員基本資料</h3>
                                    <p class="mb-0 text-muted">例如姓名、電子郵件、帳號、密碼及其他註冊資訊。</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">
                                    <h3 class="h6 fw-bold mb-2">訂單與交易資料</h3>
                                    <p class="mb-0 text-muted">例如收件人姓名、聯絡電話、配送地址、訂單內容、購買紀錄等。</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">
                                    <h3 class="h6 fw-bold mb-2">創作者申請與經營資料</h3>
                                    <p class="mb-0 text-muted">例如品牌名稱、品牌介紹、品牌圖片、銀行代碼、銀行帳號等。</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">
                                    <h3 class="h6 fw-bold mb-2">互動與內容資料</h3>
                                    <p class="mb-0 text-muted">例如商品收藏、購物車內容、作品集、創作文章、留言、通知設定等。</p>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="rounded-4 p-3" style="background-color:#faf8f5;">
                                    <h3 class="h6 fw-bold mb-2">系統自動記錄資料</h3>
                                    <p class="mb-0 text-muted">例如 IP 位址、登入時間、瀏覽行為、裝置資訊與操作紀錄。</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="policy-3" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f8f1e7;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#b07d52;color:white;">
                                03
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">資料蒐集目的</h2>
                                <p class="text-muted mb-0 small">蒐集資料是為了讓平台功能能正常運作</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <ul class="mb-0 ps-3">
                            <li class="mb-2">提供會員註冊、登入、身分驗證及帳號管理功能。</li>
                            <li class="mb-2">處理商品下單、付款、出貨、配送及售後服務。</li>
                            <li class="mb-2">提供創作者申請、商品上架、作品集展示及平台經營功能。</li>
                            <li class="mb-2">提供通知、公告、訊息提醒與系統相關服務。</li>
                            <li class="mb-2">進行網站維運、資料分析、功能優化與使用體驗改善。</li>
                            <li>防範不法行為、維護平台安全與保障雙方權益。</li>
                        </ul>
                    </div>
                </section>

                <section id="policy-4" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#eef1f4;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#6c7a89;color:white;">
                                04
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">個人資料之利用方式</h2>
                                <p class="text-muted mb-0 small">本平台如何在合理範圍內使用您的資料</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p>
                            本平台僅於蒐集目的範圍內使用您的個人資料，並依誠信原則及相關法令妥善處理。
                            除以下情形外，本平台不會任意將您的個人資料提供給第三人：
                        </p>
                        <ul class="mb-0 ps-3">
                            <li class="mb-2">已取得您的同意或授權。</li>
                            <li class="mb-2">為完成訂單、付款、物流配送或必要服務流程所需。</li>
                            <li class="mb-2">依法令規定、司法機關或主管機關要求提供。</li>
                            <li>為保護本平台、其他使用者或第三人之合法權益所必要。</li>
                        </ul>
                    </div>
                </section>

                <section id="policy-5" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f4ede7;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#8a6a55;color:white;">
                                05
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">資料保存與安全措施</h2>
                                <p class="text-muted mb-0 small">保護資料安全，是平台最基本的承諾</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p>
                            本平台採取合理且適當的資訊安全措施，以保護您的個人資料避免遭受未經授權之存取、
                            洩漏、竄改、毀損或其他侵害。包含但不限於：
                        </p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">帳號密碼加密處理。</div>
                            </div>
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">系統權限分級與存取控管。</div>
                            </div>
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">限制後台管理與敏感資料存取範圍。</div>
                            </div>
                            <div class="col-md-6">
                                <div class="rounded-4 p-3 h-100" style="background-color:#faf8f5;">透過系統監控與紀錄機制維護平台安全。</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="policy-6" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f7f2e9;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#c08a4d;color:white;">
                                06
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">Cookie 與相關技術</h2>
                                <p class="text-muted mb-0 small">幫助記住偏好與改善網站體驗的技術</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p>
                            為提供更佳的使用體驗，本平台可能使用 Cookie 或其他類似技術，以記錄您的偏好設定、
                            維持登入狀態、分析網站流量及優化功能表現。
                        </p>
                        <p class="mb-0">
                            您可自行透過瀏覽器設定管理或停用 Cookie，但若停用部分 Cookie，
                            可能導致某些功能無法正常使用。
                        </p>
                    </div>
                </section>

                <section id="policy-7" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#edf4ef;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#6e8f75;color:white;">
                                07
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">使用者權利</h2>
                                <p class="text-muted mb-0 small">您可以依法對自己的個人資料提出請求</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <ul class="mb-0 ps-3">
                            <li class="mb-2">查詢或請求閱覽。</li>
                            <li class="mb-2">請求製給複製本。</li>
                            <li class="mb-2">請求補充或更正。</li>
                            <li class="mb-2">請求停止蒐集、處理或利用。</li>
                            <li>請求刪除。</li>
                        </ul>
                    </div>
                </section>

                <section id="policy-8" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f5f0ea;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#9a765f;color:white;">
                                08
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">第三方服務</h2>
                                <p class="text-muted mb-0 small">部分功能可能會連動到外部服務提供者</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p class="mb-0">
                            本平台部分服務可能涉及第三方功能，例如金流、物流或外部連結網站。
                            當您使用該等服務時，其資料處理方式可能適用該第三方之隱私政策，
                            建議您另行參閱該第三方所提供之相關條款與說明。
                        </p>
                    </div>
                </section>

                <section id="policy-9" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f1efef;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#7e7a78;color:white;">
                                09
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">政策修訂</h2>
                                <p class="text-muted mb-0 small">政策內容可能會依需求調整與更新</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p class="mb-0">
                            本平台保留隨時修訂本隱私權政策之權利。若有重要變更，
                            將於本平台公告最新內容，恕不另行個別通知。建議您定期查閱本頁面，
                            以了解最新的隱私權保護措施。
                        </p>
                    </div>
                </section>

                <section id="policy-10" class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header border-0 p-4" style="background-color:#f8f4ee;">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3"
                                 style="width:48px;height:48px;background:#8c6d5a;color:white;">
                                10
                            </div>
                            <div>
                                <h2 class="h4 fw-bold mb-1">聯絡我們</h2>
                                <p class="text-muted mb-0 small">對隱私與個資保護有疑問時可與我們聯繫</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <p class="mb-3">
                            若您對本隱私權政策或個人資料保護事項有任何疑問，歡迎與我們聯繫。
                        </p>
                        <div class="rounded-4 p-4" style="background-color:#faf8f5;">
                            <p class="mb-2"><strong>平台名稱：</strong>CraftDailyCorner</p>
                            <p class="mb-0"><strong>聯絡信箱：</strong>support@craftdailycorner.com</p>
                        </div>
                    </div>
                </section>

            </div>
        </div>
    </div>
</div>