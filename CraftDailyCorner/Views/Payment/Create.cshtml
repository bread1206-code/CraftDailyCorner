@model CraftDailyCorner.ViewModels.Front.VMPaymentCreate

@{
    ViewData["Title"] = "付款";
}

<div class="container mt-4">
    <h2 class="mb-4">訂單付款</h2>

    <!-- 訂單資訊 -->
    <div class="card mb-4">
        <div class="card-body">
            <p><strong>訂單編號：</strong>@Model.OrderID</p>
            <p><strong>訂單成立時間：</strong>@Model.OrderCreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
            <p class="fs-5">
                <strong>付款金額：</strong>
                <span class="text-danger fw-bold">
                    NT$ @Model.OrderAmount.ToString("N0")
                </span>
            </p>
        </div>
    </div>

    <!-- 付款表單 -->
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="OrderID" value="@Model.OrderID" />

        <!-- 付款方式 -->
        <div class="mb-3">
            <label class="form-label">付款方式</label>
            <select name="MethodID" class="form-select" required>
                <option value="">請選擇付款方式</option>
                @foreach (var method in Model.PaymentMethods)
                {
                    <option value="@method.MethodID">@method.MethodName</option>
                }
            </select>
        </div>

        <!-- Mock Payment -->
        <div class="mb-4">
            <label class="form-label">模擬付款結果</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="SimulateSuccess" value="true" checked />
                <label class="form-check-label">
                    模擬付款成功
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="SimulateSuccess" value="false" />
                <label class="form-check-label">
                    模擬付款失敗
                </label>
            </div>
        </div>

        <!-- 錯誤訊息 -->
        @if (TempData["PaymentError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["PaymentError"]
            </div>
        }

        <!-- 操作按鈕 -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                確認付款
            </button>
            <a asp-controller="Order"
               asp-action="Detail"
               asp-route-orderId="@Model.OrderID"
               class="btn btn-outline-secondary">
                返回訂單
            </a>
        </div>
    </form>
</div>