@model CraftDailyCorner.Models.CreatorApplication

@{
    ViewData["Title"] = "確認創作者資料";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="mb-4">
        <h2 class="fw-bold">確認創作者資料</h2>
        <p class="text-muted mb-0">你的申請已通過，請確認資料後完成創作者建立。</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-muted small mb-1">品牌名稱</div>
                    <div class="fs-5 fw-semibold">@((Model.BrandName ?? Model.BrandName) ?? "（未填）")</div>

                    <hr />

                    <div class="text-muted small mb-1">品牌簡介</div>
                    <div style="white-space:pre-wrap;">@(Model.BrandIntro ?? "（未填）")</div>

                    <hr />

                    <div class="text-muted small mb-1">創作起始日期</div>
                    <div>@Model.StartDate.ToString("yyyy/MM/dd")</div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small mb-2">作品相片</div>
                    @if (!string.IsNullOrWhiteSpace(Model.PortfolioSampleUrl))
                    {
                        <img class="img-fluid rounded shadow-sm"
                             src="@($"/Photos/02CreatorApplication/Large/{Model.PortfolioSampleUrl}.png")" />
                    }
                    else
                    {
                        <div class="text-muted">（未上傳）</div>
                    }
                </div>
            </div>

            <hr class="my-4" />

            <form asp-controller="CreatorOnboarding"
                  asp-action="ApprovedConfirmSubmit"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="applicationId" value="@Model.ApplicationID" />

                <button type="submit" class="btn btn-primary w-100">
                    我已確認，建立創作者資料
                </button>
            </form>

        </div>
    </div>
</div>