@using CraftDailyCorner.ViewModels.CreatorOrder
@model VMCreatorOrderDetail

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@{
    ViewData["Title"] = "訂單明細";
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">訂單明細</h3>

        <a asp-action="Index"
           asp-route-status="new"
           class="btn btn-soft-secondary">
            返回列表
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <div><strong>訂單編號：</strong>@Model.OrderID</div>
                    <div><strong>建立時間：</strong>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                </div>

                <div class="col-md-6">
                    <div><strong>收件人：</strong>@Model.ReceiverName</div>
                    <div><strong>電話：</strong>@Model.ReceiverPhone</div>
                    <div><strong>地址：</strong>@Model.ShippingAddress</div>
                </div>

            </div>

            <hr />

            <div>
                <strong>狀態：</strong>

                @switch (Model.StatusID)
                {
                    case 2:
                        <span class="badge bg-danger">已付款</span>
                        break;
                    case 3:
                        <span class="badge bg-warning text-dark">準備中</span>
                        break;
                    case 4:
                        <span class="badge bg-primary">配送中</span>
                        break;
                    case 5:
                        <span class="badge bg-success">完成</span>
                        break;
                    case 6:
                        <span class="badge bg-secondary">取消</span>
                        break;
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.TrackingNo))
            {
                <div class="mt-2">
                    <strong>物流編號：</strong>
                    <span class="text-primary">@Model.TrackingNo</span>
                </div>
            }

            @if (Model.ShippedAt != null)
            {
                <div class="mt-2">
                    <strong>出貨時間：</strong>
                    <span>@Model.ShippedAt?.ToString("yyyy/MM/dd HH:mm")</span>
                </div>
            }

            @if (Model.DeliveredAt != null)
            {
                <div class="mt-2">
                    <strong>送達時間：</strong>
                    <span>@Model.DeliveredAt?.ToString("yyyy/MM/dd HH:mm")</span>
                </div>
            }

        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>商品名稱</th>
                            <th class="text-end">單價</th>
                            <th class="text-center">數量</th>
                            <th class="text-end">小計</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductNameSnapshot</td>
                                <td class="text-end">
                                    @item.PriceSnapshot.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @item.Quantity
                                </td>
                                <td class="text-end">
                                    @item.SubTotal.ToString("N0")
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div class="text-end mb-4">
        <h5>
            總金額：
            <span class="text-danger">
                @Model.TotalAmount.ToString("N0")
            </span>
        </h5>
    </div>

    @if (Model.StatusID == 3)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h5 class="fw-semibold mb-3">輸入物流編號</h5>

                <form asp-action="Ship" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.OrderID" />

                    <div class="row g-3 align-items-center">

                        <div class="col-md-6">
                            <input type="text"
                                   name="trackingNo"
                                   class="form-control"
                                   placeholder="請輸入物流編號，例如 SH202603030001"
                                   required
                                   maxlength="14"
                                   pattern="^SH\d{12}$"
                                   title="格式需為 SH + 12 碼數字（例如 SH202603030001）" />

                            <div class="invalid-feedback">
                                物流編號格式不正確，請輸入 SH + 12 碼數字。
                            </div>
                        </div>

                        <div class="col-md-3">
                            <button type="submit"
                                    class="btn btn-soft-primary w-100">
                                確認出貨
                            </button>
                        </div>

                    </div>

                    @if (!string.IsNullOrEmpty(Model.SuggestedTrackingNo))
                    {
                        <div class="text-muted mt-2">
                            模擬物流編號：
                            <strong>@Model.SuggestedTrackingNo</strong>
                        </div>
                    }
                </form>

            </div>
        </div>
    }

    @if (Model.StatusID == 4 && Model.ShipmentStatusID != 3)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">物流狀態操作</h5>

                <form asp-action="MarkDelivered" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.OrderID" />

                    <button type="submit" class="btn btn-success">
                        商品送達（模擬）
                    </button>
                </form>
            </div>
        </div>
    }

</div>