@using CraftDailyCorner.ViewModels.CreatorOrder
@model VMCreatorOrderList

@{
    ViewData["Title"] = "訂單管理";
    var currentStatus = Model.StatusFilter?.ToLower() ?? "new";
    var isNewPage = currentStatus == "new";
}

<div class="container my-5">

    <!--頁面標題 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">訂單管理</h3>
    </div>


    <!-- 狀態切換 Tabs -->
    <ul class="nav nav-tabs mb-4">

        <li class="nav-item">
            <a class="nav-link @(currentStatus == "new" ? "active" : "")"
               asp-action="Index"
               asp-route-status="new">
                新訂單
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(currentStatus == "processing" ? "active" : "")"
               asp-action="Index"
               asp-route-status="processing">
                準備中
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(currentStatus == "shipping" ? "active" : "")"
               asp-action="Index"
               asp-route-status="shipping">
                配送中
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(currentStatus == "history" ? "active" : "")"
               asp-action="Index"
               asp-route-status="history">
                歷史訂單
            </a>
        </li>

    </ul>


    <!-- 訂單列表 -->
    @if (!Model.Orders.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center text-muted p-5">
                目前沒有訂單
            </div>
        </div>
    }
    else
    {
        <!-- 新訂單才需要包 Form -->
        <form asp-action="BatchPrint" method="post">

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>

                                    @if (isNewPage)
                                    {
                                        <th style="width:50px;">
                                            <input type="checkbox" id="checkAll" />
                                        </th>
                                    }

                                    <th>訂單編號</th>
                                    <th>收件人</th>
                                    <th>建立時間</th>
                                    <th>金額</th>
                                    <th>狀態</th>
                                    <th class="text-end">操作</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var order in Model.Orders)
                                {
                                    <tr>

                                        @if (isNewPage)
                                        {
                                            <td>
                                                <input type="checkbox"
                                                       name="SelectedOrderIDs"
                                                       value="@order.OrderID"
                                                       class="order-checkbox" />
                                            </td>
                                        }

                                        <td class="fw-semibold">
                                            @order.OrderID
                                        </td>

                                        <td>@order.ReceiverName</td>

                                        <td>
                                            @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                        </td>

                                        <td>
                                            @order.TotalAmount.ToString("N0")
                                        </td>

                                        <td>
                                            @switch (order.StatusID)
                                            {
                                                case 2:
                                                    <span class="badge bg-danger">已付款</span>
                                                    break;
                                                case 3:
                                                    <span class="badge bg-warning text-dark">準備中</span>
                                                    break;
                                                case 4:
                                                    <span class="badge bg-primary">配送中</span>
                                                    @if (order.HasShipment && !string.IsNullOrEmpty(order.TrackingNo))
                                                    {
                                                        <span class="small text-muted mt-1">
                                                            (物流編號：@order.TrackingNo)
                                                        </span>
                                                    }
                                                    break;
                                                case 5:
                                                    <span class="badge bg-success">完成</span>
                                                    break;
                                                case 6:
                                                    <span class="badge bg-secondary">取消</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">
                                                        @order.StatusName
                                                    </span>
                                                    break;
                                            }
                                        </td>

                                        <td class="text-end">

                                            <a asp-action="Detail"
                                               asp-route-id="@order.OrderID"
                                               class="btn btn-sm btn-outline-secondary">
                                                查看
                                            </a>

                                            @if (order.CanProcess && !isNewPage)
                                            {
                                                <form asp-action="StartProcessing"
                                                      method="post"
                                                      class="d-inline">
                                                    <input type="hidden"
                                                           name="id"
                                                           value="@order.OrderID" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">
                                                        開始處理
                                                    </button>
                                                </form>
                                            }

                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <!-- 批次列印按鈕（只在新訂單） -->
            @if (isNewPage)
            {
                <div class="mt-3 text-end">
                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-printer"> </i>列印撿貨單
                    </button>
                </div>
            }

        </form>
    }

    <!-- 分頁 -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>


<!-- 全選功能 JS -->
@section Scripts {
    <script>
        const checkAll = document.getElementById('checkAll');

        if (checkAll) {
            checkAll.addEventListener('change', function () {
                document.querySelectorAll('.order-checkbox')
                    .forEach(cb => cb.checked = this.checked);
            });
        }
    </script>
}