@using CraftDailyCorner.ViewModels.Product
@model VMProductList

@{
    ViewData["Title"] = "商品列表";

    int pageSize = 20;
    int currentPage = Convert.ToInt32(Context.Request.Query["page"].FirstOrDefault() ?? "1");

    var totalItems = Model.Products.Count;
    var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

    var pagedProducts = Model.Products
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    string BuildPageUrl(int page)
    {
        var qs = new Dictionary<string, string?>()
        {
            { "categoryId", Model.CategoryId?.ToString() },
            { "keyword", Model.Keyword },
            { "tagId", Model.TagId?.ToString() },
            { "page", page.ToString() }
        };

        var query = string.Join("&",
            qs.Where(x => !string.IsNullOrEmpty(x.Value))
              .Select(x => $"{x.Key}={x.Value}"));

        return $"?{query}";
    }
}

<div class="container my-5">
    <!--麵包屑-->
    @await Html.PartialAsync("_BreadcrumbPartial", Model.Breadcrumb)
    <h3 class="fw-bold mb-4">@Model.PageTitle</h3>

    <!-- 商品 Card -->
    <div class="row g-4">
        @foreach (var item in pagedProducts)
        {
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card h-100 shadow-sm">

                    <a asp-action="Detail"
                       asp-route-id="@item.ProductID"
                       class="text-decoration-none text-dark">

                        <img src=@($"/Photos/04ProductImage/Large/{item.CoverImageUrl}.png")
                             class="card-img-top"
                             style="height:200px;object-fit:cover;" />
                    </a>
                        <div class="card-body">

                            <!-- 商品名稱 + 收藏（同一行） -->
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="card-title text-truncate mb-1 pe-2">
                                    @item.ProductName
                                </h6>

                                <button type="button"
                                    class="btn btn-sm p-0 border-0 bg-transparent favorite-btn focus-none"
                                        data-product-id="@item.ProductID"
                                        data-is-favorite="@item.IsFavorite.ToString().ToLower()"
                                        onclick="event.preventDefault(); event.stopPropagation();">
                                    <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                                </button>
                            </div>

                            <p class="text-danger fw-bold mb-1">
                                NT$ @Math.Floor(item.Price)
                            </p>

                        </div>
                    
                </div>
            @*  <!-- Tags -->
                <div class="card-footer bg-white border-0 pt-0">
                    @foreach (var tag in item.ProductTags.Select(pt => pt.Tag))
                    {
                        <a asp-controller="Products"
                            asp-action="Index"
                            asp-route-tagId="@tag.TagID"
                            class="badge bg-secondary text-decoration-none me-1">
                            @tag.TagName
                        </a>
                    }
                </div> *@
            </div>
        }
    </div>

    <!-- 分頁 -->
    @if (totalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@BuildPageUrl(currentPage - 1)">
                        上一頁
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@BuildPageUrl(i)">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@BuildPageUrl(currentPage + 1)">
                        下一頁
                    </a>
                </li>
            </ul>
        </nav>
    }

</div>
