@using CraftDailyCorner.ViewModels.Product
@model VMProductList

@{
    ViewData["Title"] = "商品列表";

    string BuildPageUrl(int page)
    {
        var qs = new Dictionary<string, string?>()
        {
            { "categoryId", Model.CategoryId?.ToString() },
            { "keyword", Model.Keyword },
            { "tagId", Model.TagId?.ToString() },
            { "page", page.ToString() }
        };

        var query = string.Join("&",
            qs.Where(x => !string.IsNullOrEmpty(x.Value))
              .Select(x => $"{x.Key}={x.Value}"));

        return $"?{query}";
    }
}

<div class="container my-5">
    @await Html.PartialAsync("_BreadcrumbPartial", Model.Breadcrumb)

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3 class="fw-bold mb-0">@Model.PageTitle</h3>

        <div class="text-muted small">
            共 @Model.TotalCount 筆商品，每頁 @Model.PageSize 筆
        </div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model.Products)
        {
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card h-100 shadow-sm p-card">

                    <a asp-action="Detail"
                           asp-route-id="@item.ProductID"
                           class="text-decoration-none text-dark">

                        <img src="@item.CoverImagePath"
                             class="card-img-top"
                             style="height:200px;object-fit:cover;"
                             alt="@item.ProductName" />
                    </a>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="card-title text-truncate mb-1 pe-2">
                                @item.ProductName
                            </h6>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <button type="button"
                                        class="btn btn-sm p-0 border-0 bg-transparent favorite-btn focus-none"
                                        data-product-id="@item.ProductID"
                                        data-is-favorite="@item.IsFavorite.ToString().ToLower()"
                                        onclick="event.preventDefault(); event.stopPropagation();">
                                    <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm p-0 border-0 bg-transparent focus-none"
                                        data-bs-toggle="modal"
                                        data-bs-target="#loginModal">
                                    <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                                </button>
                            }
                        </div>

                        <p class="text-danger fw-bold mb-1">
                            NT$ @Math.Floor(item.Price)
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Products.Any())
    {
        <div class="text-center text-muted mt-5">
            目前沒有符合條件的商品
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        var currentPage = Model.Page;
        var totalPages = Model.TotalPages;

        var startPage = Math.Max(1, currentPage - 2);
        var endPage = Math.Min(totalPages, currentPage + 2);

        if (currentPage <= 3)
        {
            endPage = Math.Min(totalPages, 5);
        }

        if (currentPage >= totalPages - 2)
        {
            startPage = Math.Max(1, totalPages - 4);
        }

        <nav class="mt-5" aria-label="商品分頁">
            <ul class="pagination pagination-sm justify-content-center flex-wrap">

                <!-- 第一頁 -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@(currentPage == 1 ? "#" : BuildPageUrl(1))" aria-label="第一頁">
                        &laquo;
                    </a>
                </li>

                <!-- 上一頁 -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@(currentPage == 1 ? "#" : BuildPageUrl(currentPage - 1))" aria-label="上一頁">
                        &lsaquo;
                    </a>
                </li>

                <!-- 開頭頁碼 -->
                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@BuildPageUrl(1)">1</a>
                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                <!-- 中間頁碼 -->
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@BuildPageUrl(i)">@i</a>
                    </li>
                }

                <!-- 結尾頁碼 -->
                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">
                        <a class="page-link" href="@BuildPageUrl(totalPages)">@totalPages</a>
                    </li>
                }

                <!-- 下一頁 -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@(currentPage == totalPages ? "#" : BuildPageUrl(currentPage + 1))" aria-label="下一頁">
                        &rsaquo;
                    </a>
                </li>

                <!-- 最後頁 -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@(currentPage == totalPages ? "#" : BuildPageUrl(totalPages))" aria-label="最後頁">
                        &raquo;
                    </a>
                </li>

            </ul>
        </nav>
    }
</div>