@model CraftDailyCorner.ViewModels.CreatorAnalytics.Commerce.VMCommerceDashboard
@using System.Text.Json

@{
    ViewData["Title"] = "銷售分析";
}

<div class="container-fluid py-4">

    <!-- 標題區 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">電商銷售儀表板</h2>
            <p class="text-muted mb-0">營收、訂單、銷售趨勢與商品排行</p>
        </div>

        <div>
            <a asp-controller="Creator"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">
                回創作者中心
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-5">

        <!-- Revenue -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月營收</h6>
                    <h3 class="fw-bold text-success">
                        @Model.Overview.Revenue.Current.ToString("C")
                    </h3>
                    <small class="text-muted d-block">
                        上月 @Model.Overview.Revenue.Previous.ToString("C")
                    </small>
                    <small class="text-muted d-block">
                        成長 @Model.Overview.Revenue.GrowthRate.ToString("P")
                    </small>
                </div>
            </div>
        </div>

        <!-- Orders -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月訂單數</h6>
                    <h3 class="fw-bold">
                        @Model.Overview.Orders.Current
                    </h3>
                    <small class="text-muted d-block">
                        上月 @Model.Overview.Orders.Previous
                    </small>
                    <small class="text-muted d-block">
                        成長 @Model.Overview.Orders.GrowthRate.ToString("P")
                    </small>
                </div>
            </div>
        </div>

        <!-- Quantity -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月銷售件數</h6>
                    <h3 class="fw-bold">
                        @Model.Overview.Quantity.Current
                    </h3>
                    <small class="text-muted d-block">
                        上月 @Model.Overview.Quantity.Previous
                    </small>
                    <small class="text-muted d-block">
                        成長 @Model.Overview.Quantity.GrowthRate.ToString("P")
                    </small>
                </div>
            </div>
        </div>

        <!-- AOV -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">本月平均客單價</h6>
                    <h3 class="fw-bold">
                        @Model.Overview.AverageOrderValue.ToString("C")
                    </h3>
                    <small class="text-muted d-block">
                        （本月營收 ÷ 本月訂單數）
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- Revenue Trend -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">月營收趨勢</h5>
                <span class="badge bg-primary">
                    成長率 @Model.RevenueTrend.MonthlyGrowthRate.ToString("P")
                </span>
            </div>

            <div style="height:350px;">
                <canvas id="revenueTrendChart"></canvas>
            </div>

        </div>
    </div>

    <!-- Order Trend -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">月訂單趨勢</h5>
            </div>

            <div style="height:350px;">
                <canvas id="orderTrendChart"></canvas>
            </div>

        </div>
    </div>

    <!-- Product Ranking -->
    <div class="row g-4">

        <!-- Top Revenue -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">營收排行 TOP 5</h5>

                    @if (!Model.ProductRanking.TopByRevenue.Any())
                    {
                        <div class="text-muted">尚無資料</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>商品名稱</th>
                                        <th class="text-end">營收</th>
                                        <th class="text-end">銷售數量</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ProductRanking.TopByRevenue)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:260px;">
                                                @item.ProductName
                                            </td>
                                            <td class="text-end">@item.Revenue.ToString("C")</td>
                                            <td class="text-end">@item.QuantitySold</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- Top Quantity -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">銷售數量排行 TOP 5</h5>

                    @if (!Model.ProductRanking.TopByQuantity.Any())
                    {
                        <div class="text-muted">尚無資料</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>商品名稱</th>
                                        <th class="text-end">銷售數量</th>
                                        <th class="text-end">營收</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ProductRanking.TopByQuantity)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:260px;">
                                                @item.ProductName
                                            </td>
                                            <td class="text-end">@item.QuantitySold</td>
                                            <td class="text-end">@item.Revenue.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

</div>

<!-- 傳資料給 JS -->
<div id="commerceChartData"
     data-revenue='@Html.Raw(JsonSerializer.Serialize(Model.RevenueTrend.MonthlyTrend))'
     data-orders='@Html.Raw(JsonSerializer.Serialize(Model.OrderTrend.MonthlyTrend))'>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/creatorCommerceDashboard.js"></script>
}