@model CraftDailyCorner.ViewModels.CreatorAnalytics.Commerce.VMCommerceDashboard

@{
    ViewData["Title"] = "銷售分析";

    var now = DateTime.Now;
    var currentYear = now.Year;
    var currentMonth = now.Month;

    var yearOptions = Model.FilterOptions.AvailableYears;
    var monthOptions = Model.FilterOptions.AvailableMonths;
}

<div class="container-fluid py-4">

    <!-- 標題區 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">電商銷售儀表板</h2>
            <p class="text-muted mb-0">營收、訂單、銷售趨勢與商品排行</p>
        </div>

        <div>
            <a asp-controller="Creator"
                   asp-action="Dashboard"
                   class="btn btn-outline-secondary">
                回創作者中心
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-5">

        <!-- Revenue -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月營收</h6>
                    <h3 class="fw-bold text-success">
                        @Model.Overview.Revenue.Current.ToString("C")
                    </h3>
                    <small class="text-muted d-block">
                        上月 @Model.Overview.Revenue.Previous.ToString("C")
                    </small>
                    <small class="text-muted d-block">
                        成長 @Model.Overview.Revenue.GrowthRate.ToString("P")
                    </small>
                </div>
            </div>
        </div>

        <!-- Orders -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月訂單數</h6>
                    <h3 class="fw-bold">
                        @Model.Overview.Orders.Current
                    </h3>
                    <small class="text-muted d-block">
                        上月 @Model.Overview.Orders.Previous
                    </small>
                    <small class="text-muted d-block">
                        成長 @Model.Overview.Orders.GrowthRate.ToString("P")
                    </small>
                </div>
            </div>
        </div>

        <!-- Quantity -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月銷售件數</h6>
                    <h3 class="fw-bold">
                        @Model.Overview.Quantity.Current
                    </h3>
                    <small class="text-muted d-block">
                        上月 @Model.Overview.Quantity.Previous
                    </small>
                    <small class="text-muted d-block">
                        成長 @Model.Overview.Quantity.GrowthRate.ToString("P")
                    </small>
                </div>
            </div>
        </div>

        <!-- AOV -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">本月平均客單價</h6>
                    <h3 class="fw-bold">
                        @Model.Overview.AverageOrderValue.ToString("C")
                    </h3>
                    <small class="text-muted d-block">
                        （本月營收 ÷ 本月訂單數）
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- Revenue Trend -->
    <div class="card shadow-sm border-0 mb-5 js-analytics-chart-card"
         data-chart-key="revenue"
         data-api-url="@Url.Action("GetCommerceRevenueTrend", "CreatorAnalytics")"
         data-default-mode="year"
         data-value-type="currency">
        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0">營收趨勢</h5>
                        <span class="badge bg-primary js-growth-badge">
                            成長率 @Model.RevenueTrend.MonthlyGrowthRate.ToString("P")
                        </span>
                    </div>
                    <small class="text-muted js-range-text">@currentYear 年</small>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn active" data-mode="year">
                            年度
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="rolling12">
                            近12個月
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="month">
                            單月
                        </button>
                    </div>

                    <div class="js-filter-year">
                        <select class="form-select form-select-sm js-year-select">
                            @foreach (var y in yearOptions)
                            {
                                if (y == currentYear)
                                {
                                    <option value="@y" selected>@y 年</option>
                                }
                                else
                                {
                                    <option value="@y">@y 年</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-rolling12 d-none">
                        <select class="form-select form-select-sm js-rolling12-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-month d-none">
                        <select class="form-select form-select-sm js-month-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="text-muted small mb-2 js-loading-text d-none">載入中...</div>

            <div style="height:350px;">
                <canvas id="revenueTrendChart"></canvas>
            </div>

        </div>
    </div>

    <!-- Order Trend -->
    <div class="card shadow-sm border-0 mb-5 js-analytics-chart-card"
         data-chart-key="orders"
         data-api-url="@Url.Action("GetCommerceOrderTrend", "CreatorAnalytics")"
         data-default-mode="year"
         data-value-type="count">
        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0">訂單趨勢</h5>
                        <span class="badge bg-secondary js-growth-badge d-none"></span>
                    </div>
                    <small class="text-muted js-range-text">@currentYear 年</small>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn active" data-mode="year">
                            年度
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="rolling12">
                            近12個月
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="month">
                            單月
                        </button>
                    </div>

                    <div class="js-filter-year">
                        <select class="form-select form-select-sm js-year-select">
                            @foreach (var y in yearOptions)
                            {
                                if (y == currentYear)
                                {
                                    <option value="@y" selected>@y 年</option>
                                }
                                else
                                {
                                    <option value="@y">@y 年</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-rolling12 d-none">
                        <select class="form-select form-select-sm js-rolling12-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-month d-none">
                        <select class="form-select form-select-sm js-month-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="text-muted small mb-2 js-loading-text d-none">載入中...</div>

            <div style="height:350px;">
                <canvas id="orderTrendChart"></canvas>
            </div>

        </div>
    </div>

    <!-- Product Ranking -->
    <div class="row g-4">

        <!-- Top Revenue -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">營收排行 TOP 5</h5>

                    @if (!Model.ProductRanking.TopByRevenue.Any())
                    {
                        <div class="text-muted">尚無資料</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>商品名稱</th>
                                        <th class="text-end">營收</th>
                                        <th class="text-end">銷售數量</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ProductRanking.TopByRevenue)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:260px;">
                                                @item.ProductName
                                            </td>
                                            <td class="text-end">@item.Revenue.ToString("C")</td>
                                            <td class="text-end">@item.QuantitySold</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- Top Quantity -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">銷售數量排行 TOP 5</h5>

                    @if (!Model.ProductRanking.TopByQuantity.Any())
                    {
                        <div class="text-muted">尚無資料</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>商品名稱</th>
                                        <th class="text-end">銷售數量</th>
                                        <th class="text-end">營收</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ProductRanking.TopByQuantity)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:260px;">
                                                @item.ProductName
                                            </td>
                                            <td class="text-end">@item.QuantitySold</td>
                                            <td class="text-end">@item.Revenue.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/creatorCommerceDashboard.js" asp-append-version="true"></script>
}