@model CraftDailyCorner.ViewModels.CreatorAnalytics.Community.VMCommunityDashboard

@{
    ViewData["Title"] = "社群經營分析";

    var now = DateTime.Now;
    var currentYear = now.Year;
    var currentMonth = now.Month;

    var yearOptions = Model.FilterOptions.AvailableYears;
    var monthOptions = Model.FilterOptions.AvailableMonths;
}

<div class="container-fluid py-4">

    <!-- 標題區 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">社群經營儀表板</h2>
            <p class="text-muted mb-0">內容成長、互動趨勢與反應表現</p>
        </div>

        <div>
            <a asp-controller="Creator"
                   asp-action="Dashboard"
                   class="btn btn-outline-secondary">
                回創作者中心
            </a>
        </div>
    </div>

    <!-- KPI -->
    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月貼文</h6>
                    <h3 class="fw-bold">@Model.Overview.PostsThisMonth</h3>
                    <small class="text-muted">
                        總貼文 @Model.Overview.TotalPosts（已發布 @Model.Overview.PublishedPosts / 草稿 @Model.Overview.DraftPosts）
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月作品集</h6>
                    <h3 class="fw-bold">@Model.Overview.PortfoliosThisMonth</h3>
                    <small class="text-muted">總作品集 @Model.Overview.TotalPortfolios</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">本月留言</h6>
                    <h3 class="fw-bold">@Model.Overview.CommentsThisMonth</h3>
                    <small class="text-muted">總留言 @Model.Overview.TotalComments</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="text-muted">本月反應（Reaction）</h6>
                    <h3 class="fw-bold">@Model.Overview.ReactionsThisMonth</h3>
                    <small class="text-muted">總反應 @Model.Overview.TotalReactions</small>
                </div>
            </div>
        </div>

    </div>

    <!-- 發文趨勢 -->
    <div class="card shadow-sm border-0 mb-5 js-community-chart-card"
         data-chart-key="post"
         data-api-url="@Url.Action("GetCommunityPostTrend", "CreatorAnalytics")"
         data-default-mode="year"
         data-value-type="count">
        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0">發文趨勢</h5>
                        <span class="badge bg-primary js-growth-badge">
                            成長率 @Model.ContentAnalysis.MonthlyGrowthRate.ToString("P")
                        </span>
                    </div>
                    <small class="text-muted js-range-text">@currentYear 年</small>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn active" data-mode="year">
                            年度
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="rolling12">
                            近12個月
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="month">
                            單月
                        </button>
                    </div>

                    <div class="js-filter-year">
                        <select class="form-select form-select-sm js-year-select">
                            @foreach (var y in yearOptions)
                            {
                                if (y == currentYear)
                                {
                                    <option value="@y" selected>@y 年</option>
                                }
                                else
                                {
                                    <option value="@y">@y 年</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-rolling12 d-none">
                        <select class="form-select form-select-sm js-rolling12-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-month d-none">
                        <select class="form-select form-select-sm js-month-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="text-muted small mb-2 js-loading-text d-none">載入中...</div>

            <div style="height:320px;">
                <canvas id="postTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 作品集趨勢 -->
    <div class="card shadow-sm border-0 mb-5 js-community-chart-card"
         data-chart-key="portfolio"
         data-api-url="@Url.Action("GetCommunityPortfolioTrend", "CreatorAnalytics")"
         data-default-mode="year"
         data-value-type="count">
        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0">作品集趨勢</h5>
                        <span class="badge bg-secondary js-growth-badge">
                            成長率 @Model.PortfolioAnalysis.MonthlyGrowthRate.ToString("P")
                        </span>
                    </div>
                    <small class="text-muted js-range-text">@currentYear 年</small>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn active" data-mode="year">
                            年度
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="rolling12">
                            近12個月
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="month">
                            單月
                        </button>
                    </div>

                    <div class="js-filter-year">
                        <select class="form-select form-select-sm js-year-select">
                            @foreach (var y in yearOptions)
                            {
                                if (y == currentYear)
                                {
                                    <option value="@y" selected>@y 年</option>
                                }
                                else
                                {
                                    <option value="@y">@y 年</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-rolling12 d-none">
                        <select class="form-select form-select-sm js-rolling12-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-month d-none">
                        <select class="form-select form-select-sm js-month-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="text-muted small mb-2 js-loading-text d-none">載入中...</div>

            <div style="height:320px;">
                <canvas id="portfolioTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 留言趨勢 -->
    <div class="card shadow-sm border-0 mb-5 js-community-chart-card"
         data-chart-key="comment"
         data-api-url="@Url.Action("GetCommunityCommentTrend", "CreatorAnalytics")"
         data-default-mode="year"
         data-value-type="count">
        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0">留言趨勢</h5>
                        <span class="badge bg-info js-growth-badge">
                            成長率 @Model.InteractionAnalysis.CommentGrowthRate.ToString("P")
                        </span>
                    </div>
                    <small class="text-muted js-range-text">@currentYear 年</small>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn active" data-mode="year">
                            年度
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="rolling12">
                            近12個月
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="month">
                            單月
                        </button>
                    </div>

                    <div class="js-filter-year">
                        <select class="form-select form-select-sm js-year-select">
                            @foreach (var y in yearOptions)
                            {
                                if (y == currentYear)
                                {
                                    <option value="@y" selected>@y 年</option>
                                }
                                else
                                {
                                    <option value="@y">@y 年</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-rolling12 d-none">
                        <select class="form-select form-select-sm js-rolling12-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-month d-none">
                        <select class="form-select form-select-sm js-month-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="text-muted small mb-2 js-loading-text d-none">載入中...</div>

            <div style="height:320px;">
                <canvas id="commentTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Reaction 趨勢 -->
    <div class="card shadow-sm border-0 mb-5 js-community-chart-card"
         data-chart-key="reaction"
         data-api-url="@Url.Action("GetCommunityReactionTrend", "CreatorAnalytics")"
         data-default-mode="year"
         data-value-type="count">
        <div class="card-body">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="fw-bold mb-0">反應（Reaction）趨勢</h5>
                        <span class="badge bg-dark js-growth-badge">
                            成長率 @Model.ReactionAnalysis.ReactionGrowthRate.ToString("P")
                        </span>
                    </div>
                    <small class="text-muted js-range-text">@currentYear 年</small>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">

                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn active" data-mode="year">
                            年度
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="rolling12">
                            近12個月
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm js-mode-btn" data-mode="month">
                            單月
                        </button>
                    </div>

                    <div class="js-filter-year">
                        <select class="form-select form-select-sm js-year-select">
                            @foreach (var y in yearOptions)
                            {
                                if (y == currentYear)
                                {
                                    <option value="@y" selected>@y 年</option>
                                }
                                else
                                {
                                    <option value="@y">@y 年</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-rolling12 d-none">
                        <select class="form-select form-select-sm js-rolling12-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="js-filter-month d-none">
                        <select class="form-select form-select-sm js-month-select">
                            @foreach (var item in monthOptions)
                            {
                                if (item.Year == currentYear && item.Month == currentMonth)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                </div>
            </div>

            <div class="text-muted small mb-2 js-loading-text d-none">載入中...</div>

            <div style="height:320px;">
                <canvas id="reactionTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Top 排行 -->
    <div class="row g-4 mb-5">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Top 貼文（依 Reaction）</h5>

                    @if (!Model.ReactionAnalysis.TopReactedPosts.Any())
                    {
                        <div class="text-muted">尚無資料</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="text-muted">
                                        <th>標題</th>
                                        <th class="text-end">Reaction</th>
                                        <th class="text-end">日期</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.ReactionAnalysis.TopReactedPosts)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:320px;">
                                                <a class="text-decoration-none"
                                                       href="@Url.Action("Detail", "Post", new { id = p.PostID })">
                                                    @p.Title
                                                </a>
                                            </td>
                                            <td class="text-end">@p.ReactionCount</td>
                                            <td class="text-end">@p.CreatedAt.ToString("yyyy/MM/dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Top 作品集（依 Reaction）</h5>

                    @if (!Model.ReactionAnalysis.TopReactedPortfolios.Any())
                    {
                        <div class="text-muted">尚無資料</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="text-muted">
                                        <th>標題</th>
                                        <th class="text-end">Reaction</th>
                                        <th class="text-end">日期</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.ReactionAnalysis.TopReactedPortfolios)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:320px;">
                                                <a class="text-decoration-none"
                                                       href="@Url.Action("Detail", "Portfolio", new { id = p.PortfolioID })">
                                                    @p.Title
                                                </a>
                                            </td>
                                            <td class="text-end">@p.ReactionCount</td>
                                            <td class="text-end">@p.CreatedAt.ToString("yyyy/MM/dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/creatorCommunityDashboard.js" asp-append-version="true"></script>
}