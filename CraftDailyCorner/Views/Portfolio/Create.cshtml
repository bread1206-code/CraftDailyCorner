@model CraftDailyCorner.ViewModels.CreatorPortfolio.VMCreatorPortfolioCreate

@{
    ViewData["Title"] = "新增作品集";
}

<div class="container py-5" style="max-width:900px;">

    <!-- 標題 -->
    <div class="page-header mb-4">
        <h2 class="fw-bold">新增作品集</h2>
        <p class="text-muted">建立新的作品集分類</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description"
                              class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Visibility"></label>
                    <select asp-for="Visibility"
                            asp-items="Html.GetEnumSelectList<CreatorPostVisibility>()"
                            class="form-select">
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Files"></label>
                    <input type="file"
                           asp-for="Files"
                           multiple
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-dark">
                    建立作品集
                </button>
            </form>

        </div>
    </div>

</div>