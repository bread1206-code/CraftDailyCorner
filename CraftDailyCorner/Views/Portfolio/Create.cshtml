@model CraftDailyCorner.ViewModels.CreatorPortfolio.VMCreatorPortfolioCreate

@{
    ViewData["Title"] = "新增作品集";
}

<div class="container py-5" style="max-width:900px;">

    <!-- 標題 -->
    <div class="page-header mb-4">
        <h2 class="fw-bold">新增作品集</h2>
        <p class="text-muted">建立新的作品集</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4 position-relative">

        <div id="create-overlay"
             class="position-absolute top-0 start-0 w-100 h-100
         d-flex align-items-center justify-content-center
         bg-white bg-opacity-75 d-none"
             style="z-index:10;">

            <div class="text-center">
                <div class="spinner-border text-dark mb-3"></div>
                <div class="fw-semibold">作品集與圖片上傳中...</div>
            </div>
        </div>



            <form id="create-form" 
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description"
                              class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Visibility"></label>
                    <select asp-for="Visibility"
                            asp-items="Html.GetEnumSelectList<CreatorPostVisibility>()"
                            class="form-select">
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Files"></label>
                    <input type="file"
                           asp-for="Files"
                           multiple
                           class="form-control" />
                </div>

                <button type="submit"
                        id="create-btn"
                        class="btn btn-dark">

                    建立作品集
                </button>
            </form>

        </div>
    </div>

</div>
@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

    const form = document.getElementById("create-form");
    const overlay = document.getElementById("create-overlay");
    const btn = document.getElementById("create-btn");
    const fileInput = form.querySelector('input[type="file"]');

    form.addEventListener("submit", function (e) {

        if (btn.disabled) {
            e.preventDefault();
            return;
        }

        if (fileInput.files.length > 0) {
            overlay.classList.remove("d-none");
        }

        btn.disabled = true;
        console.log("submit triggered");
    });

});
</script>

}