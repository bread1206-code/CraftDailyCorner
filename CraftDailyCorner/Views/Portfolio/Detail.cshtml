@model CraftDailyCorner.ViewModels.CreatorPortfolio.Front.VMPortfolioDetail

@{
    ViewData["Title"] = Model.Title;
}
@section Styles
{
    <link rel="stylesheet" href="~/css/PortfolioDetail.css" />
}

<div class="container py-5" style="max-width:1100px;">

    <!-- 標題區 -->
    <div class="mb-5 text-center">
        <h2 class="fw-bold">@Model.Title</h2>
        <p class="text-muted">@Model.Description</p>
        <p class="small text-secondary">
            by @Model.CreatorName · @Model.CreatedAt.ToString("yyyy/MM/dd")
        </p>
    </div>

    <!-- 畫廊區 -->
    <div class="gallery-grid">
        @foreach (var item in Model.Items)
        {
            <div class="gallery-item">
                <img src="@($"/Photos/06Portfolio/Large/{item.ImageUrl}.png")"
                     class="gallery-img"
                     onclick="openLightbox(this.src)" />
            </div>
        }
    </div>

</div>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
    <img id="lightbox-img" />
</div>

@section Scripts {
    <script src="/js/PortfolioDetail.js"></script>
}