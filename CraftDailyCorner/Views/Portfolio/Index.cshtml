@model CraftDailyCorner.ViewModels.CreatorPortfolio.Front.VMPortfolioIndex

@{
    ViewData["Title"] = "作品集";
}

<div class="container py-5" style="max-width:1100px;">

    <!-- 標題 -->
    <div class="text-center mb-2">
        <h2 class="fw-bold">作品集</h2>
        <p class="text-muted">探索最新作品分類</p>
    </div>

    <!-- 搜尋 -->
    <form method="get" class="row justify-content-center mb-3">
        <div class="col-md-6 d-flex gap-2">
            <input type="text"
                   name="PortfolioKeyword"
                   value="@Model.Query.PortfolioKeyword"
                   class="form-control"
                   placeholder="搜尋標題或內容..." />

            <button type="submit"
                    class="btn btn-soft-dark text-nowrap px-4">
                <i class="bi bi-search me-1"></i>搜尋
            </button>
        </div>
    </form>

    @if (!Model.Portfolios.Any())
    {
        <div class="text-center text-muted py-5">
            尚無符合條件的作品集
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var portfolio in Model.Portfolios)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100 p-card">

                        <a asp-action="Detail"
                               asp-route-id="@portfolio.PortfolioID"
                               class="text-decoration-none text-dark">

                            <!-- 封面圖片 -->
                            <img src="@portfolio.CoverImagePath"
                                 class="card-img-top"
                                 style="height:240px; object-fit:cover;" />

                            <div class="card-body d-flex flex-column">

                                <!-- 第1行：標題(左) + Reaction(右) -->
                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <div class="fw-semibold h5 mb-0 text-truncate flex-grow-1 me-2">
                                        <i class="bi bi-filter-right"></i>
                                        @portfolio.Title
                                        <i class="bi bi-filter-left"></i>
                                    </div>

                                    <div class="ms-2 flex-shrink-0">
                                        <partial name="_ReactionSummaryPartial"
                                                 model="portfolio.ReactionSummary" />
                                    </div>
                                </div>

                                <!-- 可見性標籤 -->
                                <div class="mb-2">
                                    @switch (portfolio.Visibility)
                                    {
                                        case CraftDailyCorner.Models.enums.CreatorVisibility.Followers:
                                            <span class="badge bg-warning text-dark">追蹤者限定</span>
                                            break;

                                        case CraftDailyCorner.Models.enums.CreatorVisibility.Private:
                                            <span class="badge bg-secondary">私密</span>
                                            break;
                                    }
                                </div>

                                <!-- 第2行：內文預覽(左) -->
                                <div class="text-muted small p-preview mb-2">
                                    @portfolio.Preview
                                </div>

                                <!-- 第3行：作者 + 日期（靠右） -->
                                <div class="text-muted small text-end mt-auto">
                                    <a asp-controller="Creator"
                                           asp-action="Profile"
                                           asp-route-id="@portfolio.CreatorID"
                                           class="text-decoration-none text-success">
                                        @portfolio.CreatorName
                                    </a>

                                    <span class="mx-2">•</span>

                                    @(portfolio.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd"))
                                </div>

                            </div>
                        </a>

                    </div>
                </div>
            }
        </div>

        <!-- 分頁 -->
        @if (Model.TotalPages > 1)
        {
            var currentPage = Model.Query.Page;
            var totalPages = Model.TotalPages;

            var startPage = Math.Max(1, currentPage - 2);
            var endPage = Math.Min(totalPages, currentPage + 2);

            if (currentPage <= 3)
            {
                endPage = Math.Min(totalPages, 5);
            }

            if (currentPage >= totalPages - 2)
            {
                startPage = Math.Max(1, totalPages - 4);
            }

            <nav class="mt-5" aria-label="作品集分頁">
                <ul class="pagination pagination-sm justify-content-center flex-wrap">

                    <!-- 第一頁 -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword"
                           aria-label="第一頁">
                            &laquo;
                        </a>
                    </li>

                    <!-- 上一頁 -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword"
                           aria-label="上一頁">
                            &lsaquo;
                        </a>
                    </li>

                    <!-- 開頭頁碼 -->
                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1"
                               asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    <!-- 中間頁碼 -->
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword">@i</a>
                        </li>
                    }

                    <!-- 結尾頁碼 -->
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }

                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@totalPages"
                               asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword">@totalPages</a>
                        </li>
                    }

                    <!-- 下一頁 -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword"
                           aria-label="下一頁">
                            &rsaquo;
                        </a>
                    </li>

                    <!-- 最後頁 -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPages"
                           asp-route-PortfolioKeyword="@Model.Query.PortfolioKeyword"
                           aria-label="最後頁">
                            &raquo;
                        </a>
                    </li>

                </ul>
            </nav>
        }
    }

</div>