@model CraftDailyCorner.ViewModels.CreatorPortfolio.VMCreatorPortfolioEdit

@{
    ViewData["Title"] = "編輯作品集";
}

<div class="container py-5" style="max-width:900px;">

    <!-- 標題 -->
    <div class="page-header mb-4">
        <h2 class="fw-bold">編輯作品集</h2>
        <p class="text-muted">
            最後更新：@Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="PortfolioID" />

                <!-- 標題 -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- 簡介 -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <!-- 可見性 -->
                <div class="mb-4">
                    <label asp-for="Visibility"
                           class="form-label"></label>

                    <select asp-for="Visibility"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<CreatorPostVisibility>()">
                    </select>

                    <span asp-validation-for="Visibility"
                          class="text-danger"></span>
                </div>

                <!-- 按鈕 -->
                <div class="d-flex justify-content-between">
                    <a asp-action="List"
                       class="btn btn-outline-secondary">
                        返回
                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">
                        更新作品集
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
