@using CraftDailyCorner.ViewModels.CreatorPortfolio
@model VMCreatorPortfolioEdit

@{
    ViewData["Title"] = "編輯作品集";
}

<div class="container py-5" style="max-width:1000px;">

    <!-- 作品集基本資料 -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">作品集資訊</h4>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PortfolioID" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="Visibility" class="form-label fw-semibold"></label>
                    <select asp-for="Visibility"
                            asp-items="Html.GetEnumSelectList<CreatorPostVisibility>()"
                            class="form-select">
                    </select>
                </div>

                <button type="submit" class="btn btn-dark">
                    儲存修改
                </button>

                <a asp-action="List"
                   class="btn btn-outline-secondary ms-2">
                    返回列表
                </a>
            </form>

        </div>
    </div>

    <!-- 圖片管理 -->
    <div class="card shadow-sm border-0 position-relative" id="portfolio-card">

        <div class="card-body p-4">
            <div id="upload-overlay"
                 class="position-absolute top-0 start-0 w-100 h-100
            d-flex align-items-center justify-content-center
            bg-white bg-opacity-75 d-none"
                 style="z-index:10;">

                <div class="text-center">
                    <div class="spinner-border text-dark mb-3" role="status"></div>
                    <div class="fw-semibold">圖片上傳中...</div>
                </div>

            </div>
            <div class="d-flex">
                <h4 class="fw-bold mb-3 me-5">圖片管理</h4>
                <div class="form-check mb-3">
                    <input class="form-check-input"
                           type="checkbox"
                           id="quick-delete-toggle">

                    <label class="form-check-label text-danger fw-semibold"
                           for="quick-delete-toggle">
                        快速刪除模式
                    </label>
                </div>
            </div>
            
            <div id="quick-delete-alert"
                 class="alert alert-warning d-none py-2">
                <i class="bi bi-exclamation-triangle me-1"> </i>您已開啟快速刪除模式，點擊即會刪除圖片
            </div>
            <div class="mb-3 text-muted">
                已上傳 @Model.Items.Count 張圖片
                （最多 50 張）
            </div>
            <!-- 上傳 -->
            <form id="upload-form"
                  enctype="multipart/form-data"
                  class="mb-3">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="portfolioId"
                       value="@Model.PortfolioID" />

                <input type="file"
                       name="files"
                       id="upload-files"
                       multiple
                       class="form-control mb-3" />

                <button type="submit"
                        id="upload-btn"
                        class="btn btn-primary"
                        disabled>
                    上傳圖片
                </button>

            </form>

            <hr />

            <!-- ⭐ 只呼叫 Partial -->
            <div id="portfolio-items-container">
                @await Html.PartialAsync("_PortfolioItemListPartial", Model)
            </div>

        </div>
        
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            //DOM 參照
            const uploadForm = document.getElementById("upload-form");
            const fileInput = document.getElementById("upload-files");
            const uploadBtn = document.getElementById("upload-btn");
            const overlay = document.getElementById("upload-overlay");
            const container = document.getElementById("portfolio-items-container");
            const quickToggle = document.getElementById("quick-delete-toggle");
            const quickAlert = document.getElementById("quick-delete-alert");

            quickToggle.addEventListener("change", function () {

            if (this.checked) {
                quickAlert.classList.remove("d-none");
            } else {
                quickAlert.classList.add("d-none");
            }
        });

            //共用工具

            function getToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]').value;
            }

            function showOverlay() {
                overlay.classList.remove("d-none");
            }

            function hideOverlay() {
                overlay.classList.add("d-none");
            }

            async function handleResponse(response) {
                if (!response.ok) {
                    const message = await response.text();
                    alert(message);
                    throw new Error(message);
                }
                return await response.text();
            }

            function refreshPartial(html) {
                container.innerHTML = html;
                initSortable();
            }

        // 刪除圖片（支援快速模式）
        document.addEventListener("click", async function (e) {

            if (!e.target.classList.contains("btn-delete"))
                return;

            const quickMode = document.getElementById("quick-delete-toggle").checked;

            //  非快速模式才顯示 confirm
            if (!quickMode) {
                if (!confirm("確定刪除圖片？")) return;
            }

            const itemId = e.target.dataset.itemid;

            const formData = new FormData();
            formData.append("itemId", itemId);
            formData.append("__RequestVerificationToken", getToken());

            try {
                showOverlay();

                const response = await fetch("/PortfolioItem/Delete", {
                    method: "POST",
                    body: formData
                });

                const html = await handleResponse(response);
                refreshPartial(html);

            } catch (err) {
                console.error(err);
            } finally {
                hideOverlay();
            }
        });

            //控制上傳按鈕啟用
            fileInput.addEventListener("change", function () {
                uploadBtn.disabled = this.files.length === 0;
            });

            //上傳圖片
            uploadForm.addEventListener("submit", async function (e) {

                e.preventDefault();

                if (fileInput.files.length === 0)
                    return;

                const formData = new FormData(uploadForm);

                try {
                    showOverlay();
                    uploadBtn.disabled = true;

                    const response = await fetch("/PortfolioItem/Upload", {
                        method: "POST",
                        body: formData
                    });

                    const html = await handleResponse(response);
                    refreshPartial(html);

                    fileInput.value = "";
                    uploadBtn.disabled = true;

                } catch (err) {
                    console.error(err);
                } finally {
                    hideOverlay();
                }
            });

            // 初始化拖曳
            initSortable();
        });


        //拖曳排序
        function initSortable() {

            const el = document.getElementById("sortable-list");
            if (!el) return;

            new Sortable(el, {
                animation: 150,
                ghostClass: 'bg-light',

                onEnd: async function () {

                    const items = el.querySelectorAll(".sortable-item");

                    const data = [];
                    let order = 1;

                    items.forEach(item => {
                        data.push({
                            itemId: parseInt(item.dataset.itemid),
                            sortOrder: order++
                        });
                    });

                    await fetch("/PortfolioItem/UpdateSort", {
                        method: "POST",
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken':
                                document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(data)
                    });

                    console.log("排序更新完成");
                }
            });
        }
    </script>
}