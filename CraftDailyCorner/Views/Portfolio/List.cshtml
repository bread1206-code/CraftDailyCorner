@model List<CraftDailyCorner.ViewModels.CreatorPortfolio.VMCreatorPortfolioListItem>

@{
    ViewData["Title"] = "管理作品集";
}

<div class="container py-5" style="max-width:1000px;">

    <!-- 標題區 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">作品集管理</h2>
            <p class="text-muted mb-0">管理您的作品集分類</p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            新增作品集
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    尚未建立任何作品集
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>標題</th>
                                <th style="width:120px;">可見性</th>
                                <th style="width:120px;">作品數量</th>
                                <th style="width:160px;">更新時間</th>
                                <th style="width:180px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @item.Title
                                        </div>
                                        <div class="text-muted small">
                                            建立於 @item.CreatedAt.ToString("yyyy/MM/dd")
                                        </div>
                                    </td>

                                    <td>
                                        @item.Visibility.ToString()
                                    </td>

                                    <td>
                                        @item.ItemCount
                                    </td>

                                    <td>
                                        @item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.PortfolioID"
                                               class="btn btn-sm btn-outline-secondary">
                                                編輯
                                            </a>

                                            <a asp-controller="Portfolio"
                                               asp-action="Edit"
                                               asp-route-id="@item.PortfolioID"
                                               class="btn btn-sm btn-outline-dark">
                                                管理作品
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.PortfolioID"
                                                  method="post"
                                                  onsubmit="return confirm('確定要刪除作品集嗎？');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    刪除
                                                </button>
                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>