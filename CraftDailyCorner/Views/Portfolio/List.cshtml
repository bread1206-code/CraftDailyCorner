@model List<CraftDailyCorner.ViewModels.CreatorPortfolio.VMCreatorPortfolioListItem>

@{
    ViewData["Title"] = "管理作品集";
}

<div class="container py-4">

    <!-- 標題區 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">作品集管理</h2>
            <p class="text-muted mb-0">管理您的作品集</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Creator"
               asp-action="Dashboard"
                   class="btn btn-soft-secondary">
                回創作者中心
            </a>

            <a asp-action="Create" class="btn btn-soft-primary">
                <i class="bi bi-plus-circle"></i> 新增作品集
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            尚未建立任何作品集。
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>作品集</th>
                            <th style="width:120px;">可見性</th>
                            <th style="width:120px;">作品數量</th>
                            <th style="width:160px;">更新時間</th>
                            <th class="text-end" style="width:220px;">操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@item.CoverImagePath"
                                             class="rounded border"
                                             style="width:60px;height:60px;object-fit:cover;" />

                                        <div>
                                            <a asp-controller="Portfolio" asp-action="Detail" asp-route-id="@item.PortfolioID"
                                               class="text-decoration-none">
                                                @item.Title
                                            </a>

                                            <div class="text-muted small">
                                                建立於 @item.CreatedAt.ToString("yyyy/MM/dd")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @item.Visibility.GetDisplayName()
                                </td>

                                <td>
                                    @item.ItemCount
                                </td>

                                <td>
                                    @item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.PortfolioID"
                                       class="btn btn-sm btn-outline-secondary me-2">
                                        管理作品
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.PortfolioID"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('確定要刪除作品集嗎？');">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            刪除
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

</div>