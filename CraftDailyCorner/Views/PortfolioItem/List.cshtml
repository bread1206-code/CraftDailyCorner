@model List<CraftDailyCorner.ViewModels.CreatorPortfolio.VMCreatorPortfolioItemListItem>

@{
    ViewData["Title"] = "管理作品";
    var portfolioId = ViewBag.PortfolioId as string;
}

<div class="container py-5" style="max-width:1100px;">

    <!-- 標題 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">作品管理</h2>
            <p class="text-muted mb-0">管理此作品集中的作品圖片</p>
        </div>

        <a asp-action="Create"
           asp-route-portfolioId="@portfolioId"
           class="btn btn-dark">
            新增作品
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-5 text-center text-muted">
                尚未新增任何作品
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">

                        <img src=@($"/Photos/Portfolio/Medium/{item.ImageUrl}.png")
                             class="card-img-top"
                             style="height:200px; object-fit:cover;" />

                        <div class="card-body">

                            <h6 class="fw-semibold mb-2">
                                @item.Title
                            </h6>

                            <p class="text-muted small mb-3">
                                排序：@item.SortOrder
                            </p>

                            <div class="d-flex gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@item.ItemID"
                                   class="btn btn-sm btn-outline-secondary">
                                    編輯
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.ItemID"
                                      method="post"
                                      onsubmit="return confirm('確定要刪除作品嗎？');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        刪除
                                    </button>
                                </form>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>