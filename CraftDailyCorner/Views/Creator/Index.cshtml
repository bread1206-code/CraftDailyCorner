@model CraftDailyCorner.ViewModels.Creator.VMCreatorIndex

@{
    ViewData["Title"] = "創作者";
}

<div class="container py-5" style="max-width:1100px;">

    <div class="page-header mb-4">
        <h2 class="fw-bold">探索創作者</h2>
        <p class="text-muted">發掘最新加入的創作者</p>
    </div>

    <div class="row g-4">
        @foreach (var creator in Model.Creators)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center">

                        <img src="@creator.ImagePath"
                             class="rounded-circle mb-3"
                             style="width:100px;height:100px;object-fit:cover;" />

                        <h5 class="fw-semibold">
                            @creator.DisplayName
                        </h5>

                        <p class="text-muted small">
                            @creator.Intro
                        </p>

                        <p class="small text-secondary">
                            粉絲數：@creator.FollowerCount
                        </p>

                        <a asp-action="Profile"
                           asp-route-id="@creator.CreatorID"
                           class="btn btn-outline-dark btn-sm">
                            查看創作者
                        </a>

                    </div>

                </div>
            </div>
        }
    </div>

</div>