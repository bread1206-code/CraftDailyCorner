@model CraftDailyCorner.ViewModels.Creator.VMCreatorIndex

@{
    ViewData["Title"] = "創作者";
}

<div class="container py-5" style="max-width:1200px;">

    <!-- 標題 -->
    <div class="text-center mb-2">
        <h2 class="fw-bold">探索創作者</h2>
        <p class="text-muted">發掘最新加入的創作者</p>
    </div>

    <!-- 搜尋 -->
    <form method="get" class="row justify-content-center mb-3">
        <div class="col-md-6 d-flex gap-2">
            <input type="text"
                   name="keyword"
                   value="@Model.Query.Keyword"
                   class="form-control"
                   placeholder="搜尋創作者名稱或介紹..." />

            <button type="submit"
                    class="btn btn-soft-dark text-nowrap px-4">
                <i class="bi bi-search me-1"></i>搜尋
            </button>
        </div>
    </form>

    @if (!Model.Creators.Any())
    {
        <div class="text-center text-muted py-5">
            尚無符合條件的創作者
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var creator in Model.Creators)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100 p-card">

                        <!-- 整張卡片超連結 -->
                        <a asp-action="Profile"
                           asp-route-id="@creator.CreatorID"
                           class="text-decoration-none text-dark d-block h-100">

                            <div class="card-body text-center d-flex flex-column">

                                <div class="d-flex justify-content-center mb-3">
                                    <img src="@creator.ImagePath"
                                         class="rounded-circle"
                                         style="width:100px;height:100px;object-fit:cover;" />
                                </div>

                                <div class="fw-semibold h5 mb-2 text-truncate">
                                    <i class="bi bi-filter-right"></i>
                                    @creator.BrandName
                                    <i class="bi bi-filter-left"></i>
                                </div>

                                <div class="text-muted small p-preview mb-2">
                                    @creator.BrandIntro
                                </div>

                                <div class="text-muted small text-end mt-auto w-100">
                                    <i class="bi bi-people"></i>
                                    @creator.FollowerCount 位粉絲

                                    <span class="mx-2">•</span>

                                    @(creator.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd"))
                                </div>

                            </div>
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    @if (Model.TotalPages > 1)
    {
        var currentPage = Model.Query.Page;
        var totalPages = Model.TotalPages;

        var startPage = Math.Max(1, currentPage - 2);
        var endPage = Math.Min(totalPages, currentPage + 2);

        if (currentPage <= 3)
        {
            endPage = Math.Min(totalPages, 5);
        }

        if (currentPage >= totalPages - 2)
        {
            startPage = Math.Max(1, totalPages - 4);
        }

        <nav class="mt-5" aria-label="創作者分頁">
            <ul class="pagination pagination-sm justify-content-center flex-wrap">

                <!-- 第一頁 -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="1"
                       asp-route-keyword="@Model.Query.Keyword"
                       aria-label="第一頁">
                        &laquo;
                    </a>
                </li>

                <!-- 上一頁 -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-keyword="@Model.Query.Keyword"
                       aria-label="上一頁">
                        &lsaquo;
                    </a>
                </li>

                <!-- 開頭頁碼 -->
                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@Model.Query.Keyword">1</a>
                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                <!-- 中間頁碼 -->
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-keyword="@Model.Query.Keyword">@i</a>
                    </li>
                }

                <!-- 結尾頁碼 -->
                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPages"
                           asp-route-keyword="@Model.Query.Keyword">@totalPages</a>
                    </li>
                }

                <!-- 下一頁 -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-keyword="@Model.Query.Keyword"
                       aria-label="下一頁">
                        &rsaquo;
                    </a>
                </li>

                <!-- 最後頁 -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@totalPages"
                       asp-route-keyword="@Model.Query.Keyword"
                       aria-label="最後頁">
                        &raquo;
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>