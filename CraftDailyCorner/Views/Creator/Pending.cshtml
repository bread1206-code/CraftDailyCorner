@model CraftDailyCorner.ViewModels.Front.CreatorApplication.VMCreatorApplicationPending

@{
    ViewData["Title"] = "創作者申請審核中";
}

<div class="alert alert-info">
    <h4 class="alert-heading">申請已送出</h4>
    <p class="mb-2">
        你的創作者申請已成功送出，目前正在審核中。
    </p>
    <hr />
    <p class="mb-1">
        <strong>創作者暱稱：</strong>@Model.DisplayName
    </p>
    <p class="mb-0">
        <strong>申請時間：</strong>@Model.AppliedAt.ToString("yyyy/MM/dd HH:mm")
    </p>
</div>

<p class="text-muted">
    審核通常需要 3～5 個工作天，請耐心等候。
    審核完成後，系統將會更新你的申請狀態。
</p>