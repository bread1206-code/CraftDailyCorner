@model CraftDailyCorner.ViewModels.CreatorApplication.VMRejectedConfirm
@{
    ViewData["Title"] = "申請結果確認";
}

<div class="container py-5" style="max-width: 820px;">

    <div class="text-center mb-4">
        <i class="bi bi-heartbreak-fill text-danger" style="font-size: 3rem;"></i>
        <h2 class="fw-bold mt-2">這次沒有通過，但別灰心！</h2>
        <p class="text-muted mb-0">
            我們相信你的創作很有潛力，調整後再挑戰一次吧。
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            @if (!string.IsNullOrWhiteSpace(Model.BrandName))
            {
                <div class="mb-3">
                    <div class="text-muted small">品牌名稱</div>
                    <div class="fw-semibold">@Model.BrandName</div>
                </div>
            }

            <div class="mb-3">
                <div class="text-muted small">未通過原因</div>
                <div class="p-3 bg-light rounded">
                    @if (string.IsNullOrWhiteSpace(Model.ReviewNote))
                    {
                        <span class="text-muted">（未提供原因）</span>
                    }
                    else
                    {
                        @Model.ReviewNote
                    }
                </div>
            </div>

            <form asp-action="RejectedConfirm" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ApplicationID" />

                <div class="text-danger mb-3">
                    @Html.ValidationSummary(false)
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-controller="Member" asp-action="Index" class="btn btn-soft-secondary">
                        返回個人中心
                    </a>

                    <button type="submit" class="btn btn-soft-primary">
                        我知道了，確認結果
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>