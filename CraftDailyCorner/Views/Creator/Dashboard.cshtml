@using CraftDailyCorner.ViewModels.Creator
@model VMCreatorDashboard

@{
    ViewData["Title"] = "創作者專區";

    string brandImageUrl = string.IsNullOrEmpty(Model.ImageUrl)
        ? "/Photos/Creator/Brand/default.png"
        : $"/Photos/03CreatorBrand/{Model.CreatorID}/Large/{Model.ImageUrl}.png?v={Model.UpdatedAt.Ticks}";
}

<div class="container my-5">

    <!--創作者歡迎資訊區塊（品牌形象 + 基本資料） -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body d-flex flex-column flex-md-row align-items-center gap-4">

            <!-- 品牌圖片 -->
            <img src="@brandImageUrl"
                 alt="品牌圖片"
                 class="rounded border"
                 style="width:400px;height:200px;object-fit:contain;" />

            <!-- 品牌資訊 -->
            <div class="flex-grow-1 text-center text-md-start">
                <h3 class="fw-bold mb-1">
                    歡迎回來，@Model.BrandName
                </h3>

                <p class="text-muted mb-2">
                    感謝你持續在這裡分享你的創作。
                </p>

                <div class="small text-muted">
                    創作起始日：@Model.StartDate.ToString("yyyy/MM/dd")
                    <span class="mx-2">｜</span>
                    成為創作者於：@Model.CreatedAt.ToString("yyyy/MM/dd")
                </div>
                <div>
                    <a asp-controller="Creator"
                       asp-action="BrandEdit"
                       class="btn btn-soft-filter btn-sm mt-3 focus-none">
                        編輯品牌資料
                    </a>
                    <a asp-controller="Messages"
                       asp-action="Index"
                       class="btn btn-soft-filter btn-sm mt-3 focus-none">
                        <i class="bi bi-chat-dots"></i>
                        訊息管理
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!--品牌簡介區塊 -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <h5 class="fw-semibold mb-3">
                關於你的品牌
            </h5>

            <p class="mb-0 text-muted">
                @Model.BrandIntro
            </p>
        </div>
    </div>


    
    <!--創作與商品管理總覽區塊 -->
    
    <div class="row g-4 mb-3">

        <!-- 商品管理 -->
        <div class="col-md-4">
            <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column">

                    <i class="bi bi-box-seam fs-1 text-primary mb-2"></i>

                    <div class="fs-5 fw-semibold">已上架商品</div>

                    <div class="fs-2 fw-bold text-primary mb-3">
                        @Model.ProductCount
                    </div>

                    <div class="mt-auto">
                        <a asp-controller="CreatorProducts"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm w-100 position-relative">
                            商品管理
                            @if (Model.InventoryAlertCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @(Model.InventoryAlertCount >= 10
                                        ? "9+"
                                        : Model.InventoryAlertCount.ToString())
                                </span>
                            }
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- 作品集管理 -->
        <div class="col-md-4">
            <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column">

                    <i class="bi bi-images fs-1 text-success mb-2"></i>

                    <div class="fs-5 fw-semibold">作品集</div>

                    <div class="fs-2 fw-bold text-success mb-3">
                        @Model.PortfolioCount
                    </div>

                    <div class="mt-auto">
                        <a asp-controller="Portfolio"
                           asp-action="List"
                           class="btn btn-outline-success btn-sm w-100">
                            作品集管理
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- 創作日誌管理 -->
        <div class="col-md-4">
            <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column">

                    <i class="bi bi-journal-text fs-1 text-purple mb-2"></i>

                    <div class="fs-5 fw-semibold">創作日誌</div>

                    <div class="fs-2 fw-bold text-purple mb-3">
                        @Model.PostCount
                    </div>

                    <div class="mt-auto">
                        <a asp-controller="Post"
                           asp-action="List"
                           class="btn btn-outline-purple btn-sm w-100">
                            日誌管理
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>


    
    <!--訂單管理總覽區塊-->
    
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="fw-semibold mb-4">
                訂單管理
            </h5>

            <div class="row g-3">

                <!-- 新訂單 -->
                <div class="col-md-3">
                    <a asp-controller="CreatorOrders"
                       asp-action="Index"
                       asp-route-status="new"
                       class="text-decoration-none">
                        <div class="border rounded p-3 text-center hover-card">
                            <div class="fw-semibold">新訂單</div>
                            <div class="fs-4 text-danger">
                                @Model.NewOrderCount
                            </div>
                        </div>
                    </a>
                </div>

                <!-- 準備中 -->
                <div class="col-md-3">
                    <a asp-controller="CreatorOrders"
                       asp-action="Index"
                       asp-route-status="processing"
                       class="text-decoration-none">
                        <div class="border rounded p-3 text-center hover-card">
                            <div class="fw-semibold">準備中</div>
                            <div class="fs-4 text-warning">
                                @Model.ProcessingOrderCount
                            </div>
                        </div>
                    </a>
                </div>

                <!-- 配送中 -->
                <div class="col-md-3">
                    <a asp-controller="CreatorOrders"
                       asp-action="Index"
                       asp-route-status="shipping"
                       class="text-decoration-none">
                        <div class="border rounded p-3 text-center hover-card">
                            <div class="fw-semibold">配送中</div>
                            <div class="fs-4 text-primary">
                                @Model.ShippingOrderCount
                            </div>
                        </div>
                    </a>
                </div>

                <!-- 歷史訂單 -->
                <div class="col-md-3">
                    <a asp-controller="CreatorOrders"
                       asp-action="Index"
                       asp-route-status="history"
                       class="text-decoration-none">
                        <div class="border rounded p-3 text-center hover-card">
                            <div class="fw-semibold">歷史訂單</div>
                            <div class="fs-4 text-secondary">
                                @Model.HistoryOrderCount
                            </div>
                        </div>
                    </a>
                </div>

            </div>

        </div>
    </div>

    <!-- 🔥 數據分析入口區塊（新增） -->
    <!-- ========================= -->

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h5 class="fw-semibold mb-4">
                數據分析中心
            </h5>

            <div class="row g-4">

                <!-- 電商銷售分析 -->
                <div class="col-md-6">
                    <div class="card hover-card h-100 shadow-sm border-0">
                        <div class="card-body text-center d-flex flex-column">

                            <i class="bi bi-graph-up-arrow fs-1 text-success mb-3"></i>

                            <div class="fs-5 fw-semibold">
                                電商銷售分析
                            </div>

                            <p class="text-muted small mb-4">
                                查看營收趨勢、商品銷售排行與客單價分析
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="CreatorAnalytics"
                                   asp-action="Commerce"
                                   class="btn btn-success w-100">
                                    前往銷售儀表板
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- 社群經營分析 -->
                <div class="col-md-6">
                    <div class="card hover-card h-100 shadow-sm border-0">
                        <div class="card-body text-center d-flex flex-column">

                            <i class="bi bi-bar-chart-line fs-1 text-primary mb-3"></i>

                            <div class="fs-5 fw-semibold">
                                社群經營分析
                            </div>

                            <p class="text-muted small mb-4">
                                分析發文成長、留言互動與社群價值表現
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="CreatorAnalytics"
                                   asp-action="Community"
                                   class="btn btn-primary w-100">
                                    前往社群儀表板
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </div>

</div>