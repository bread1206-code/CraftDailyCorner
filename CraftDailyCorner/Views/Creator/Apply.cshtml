@model CraftDailyCorner.ViewModels.Front.CreatorApplication.VMCreatorApplicationApply

@{
    ViewData["Title"] = "申請成為創作者";
}


<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="text-center mb-5">
                
                <h2 class="fw-bold mb-3" style="color: var(--bs-body-color);">開啟你的職人旅程</h2>
                <p class="text-muted mx-auto" style="max-width: 500px;">
                    在這裡，每一個手作故事都值得被聽見。<br>
                    填寫下方的申請表，打造屬於你的設計館，讓世界看見你的創作。
                </p>
            </div>

            <div class="card apply-card p-4 p-md-5">
                <form asp-action="Apply" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="DisplayName" class="form-label">
                            <span class="step-indicator">1</span>品牌名稱
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-shop"></i>
                            </span>
                            <input asp-for="DisplayName" class="form-control border-start-0 ps-0" placeholder="例如：日日好陶" />
                        </div>
                        <span asp-validation-for="DisplayName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Intro" class="form-label">
                            <span class="step-indicator">2</span>關於你的創作
                        </label>
                        <textarea asp-for="Intro" class="form-control" rows="5"
                                  placeholder="請和我們分享你的品牌故事、創作靈感或是材質特色...（這將會顯示在你的創作者首頁）"></textarea>
                        <div class="form-text text-end">建議 50 - 200 字，溫暖的文字更能打動人心。</div>
                        <span asp-validation-for="Intro" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            <span class="step-indicator">3</span>上傳代表作品
                        </label>

                        <input asp-for="PortfolioSample" type="file" class="d-none" id="fileInput" accept="image/png,image/jpeg" />

                        <label for="fileInput" class="upload-zone" id="dropZone">

                            <img id="preview-image-bg" alt="作品預覽" />

                            <div class="upload-placeholder">
                                <i class="bi bi-images mb-3"></i>
                                <h6 class="fw-bold text-dark">點擊上傳圖片</h6>
                                <p class="text-muted small mt-2 opacity-50">支援 JPG / PNG (建議尺寸 800x800 以上)</p>
                            </div>
                        </label>
                        <span asp-validation-for="PortfolioSample" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="StartDate" class="form-label">
                            <span class="step-indicator">4</span>創作起始日
                        </label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            <i class="bi bi-send-fill me-2"></i>送出創作者申請
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn mt-2">
                            暫時不想申請，返回首頁
                        </a>
                    </div>

                </form>
            </div>

            <div class="text-center mt-4 text-muted small opacity-75">
                <i class="bi bi-shield-check me-1"></i> 申請送出後，我們將於 3-5 個工作天內完成審核
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ImagePreview.js"></script>
}