@model CraftDailyCorner.ViewModels.Creator.VMCreatorPublicProfile

@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="container pt-4 pb-5" style="max-width:1100px;">
    <div class="text-end mb-2">
        <a asp-controller="Creator"
           asp-action="Index"
           class="btn btn-outline-secondary">
            回創作者首頁
        </a>
    </div>
    <!-- 創作者資訊 -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body p-4 d-flex align-items-center">

            <img src="@Model.CreatorImagePath"
                 class="rounded-circle me-4"
                 style="width:120px;height:120px;object-fit:cover;" />

            <div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold">@Model.DisplayName</h3>
                    @if (!Model.IsOwner)
                    {
                        @await Html.PartialAsync("_FollowButtonPartial", Model.FollowInfo)
                    }
                </div>
                

                <p class="text-muted mb-2">
                    創作起始：@Model.StartDate.ToString("yyyy/MM/dd")
                </p>
                <p class="mb-0">@Model.Intro</p>
            </div>
        </div>
    </div>
    

    <!-- 最新日誌 -->
    <div class="mb-5">
        <h4 class="fw-bold mb-3">最新日誌</h4>

        <div class="row g-4">
            @foreach (var item in Model.LatestPosts)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100 p-card">

                        <a asp-controller="Post"
                            asp-action="Detail"
                           asp-route-id="@item.PostID"
                           class="text-decoration-none text-dark">

                            <!-- 封面 -->
                            <img src="@item.CoverImagePath"
                                 class="card-img-top"
                                 style="height:240px; object-fit:cover;" />

                            <div class="card-body d-flex flex-column">

                                <!-- 第1行：標題(左) + Reaction(右) -->
                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <!-- 標題 -->
                                    <div class="fw-semibold h5 mb-0 text-truncate flex-grow-1 me-2">
                                        <i class="bi bi-filter-right"></i>
                                        @item.Title
                                        <i class="bi bi-filter-left"></i>
                                    </div>

                                    <!-- Reaction Summary -->
                                    <div class="ms-2 flex-shrink-0">
                                        <partial name="_ReactionSummaryPartial"
                                                 model="item.ReactionSummary" />
                                    </div>
                                </div>

                                <!-- 第2行：內文預覽(左) -->
                                <div class="text-muted small p-preview mb-2">
                                    @item.Preview
                                </div>

                                <!-- 第3行：留言數量 + 日期（靠右） -->
                                <div class="text-muted small text-end mt-auto">
                                    <i class="bi bi-chat-left-dots"></i>
                                    @item.CommentCount 則留言

                                    <span class="mx-2">•</span>

                                    @(item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd"))
                                </div>

                            </div>
                        </a>

                    </div>

                </div>
            }
        </div>
    </div>

    <!-- 最新作品集 -->
    <div>
        <h4 class="fw-bold mb-3">作品集</h4>

        <div class="row g-4">
            @foreach (var portfolio in Model.LatestPortfolios)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100 p-card">

                        <!-- ✅整張卡都是連結 -->
                        <a asp-controller="Portfolio"
                           asp-action="Detail"
                           asp-route-id="@portfolio.PortfolioID"
                           class="text-decoration-none text-dark">

                            <!-- 封面圖片 -->
                            <img src="@portfolio.CoverImagePath"
                                 class="card-img-top"
                                 style="height:240px; object-fit:cover;" />

                            <div class="card-body d-flex flex-column">

                                <!-- 第1行：標題(左) + Reaction(右) -->
                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <div class="fw-semibold h5 mb-0 text-truncate flex-grow-1 me-2">
                                        <i class="bi bi-filter-right"></i>
                                        @portfolio.Title
                                        <i class="bi bi-filter-left"></i>
                                    </div>

                                    <div class="ms-2 flex-shrink-0">
                                        <partial name="_ReactionSummaryPartial"
                                                 model="portfolio.ReactionSummary" />
                                    </div>
                                </div>

                                <!-- 第2行：內文預覽(左) -->
                                <div class="text-muted small p-preview mb-2">
                                    @portfolio.Preview
                                </div>

                                <!-- 第3行：作者 + 日期（靠右） -->
                                <div class="text-muted small text-end mt-auto">
                                    @portfolio.CreatorName

                                    <span class="mx-2">•</span>

                                    @(portfolio.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd"))
                                </div>

                            </div>
                        </a>

                    </div>
                </div>
            }
        </div>
    </div>
    <!--近期上架-->
    <div class="mt-5">
        <h4 class="fw-bold mb-3">近期上架</h4>

        <div class="row g-4">
            @foreach (var item in Model.LatestProducts)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm p-card">

                        <a asp-controller="Products"
                           asp-action="Detail"
                           asp-route-id="@item.ProductID"
                           class="text-decoration-none text-dark">

                            <img src="@item.CoverImagePath"
                                 class="card-img-top"
                                 style="height:200px;object-fit:cover;" />
                        </a>
                        <div class="card-body">

                            <!-- 商品名稱 + 收藏（同一行） -->
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="card-title text-truncate mb-1 pe-2">
                                    @item.ProductName
                                </h6>

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button"
                                            class="btn btn-sm p-0 border-0 bg-transparent favorite-btn focus-none"
                                            data-product-id="@item.ProductID"
                                            data-is-favorite="@item.IsFavorite.ToString().ToLower()"
                                            onclick="event.preventDefault(); event.stopPropagation();">
                                        <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm p-0 border-0 bg-transparent focus-none"
                                            data-bs-toggle="modal"
                                            data-bs-target="#loginModal">
                                        <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                                    </button>
                                }
                            </div>

                            <p class="text-danger fw-bold mb-1">
                                NT$ @Math.Floor(item.Price)
                            </p>

                        </div>

                    </div>
                    @*  <!-- Tags -->
                <div class="card-footer bg-white border-0 pt-0">
                    @foreach (var tag in item.ProductTags.Select(pt => pt.Tag))
                    {
                        <a asp-controller="Products"
                            asp-action="Index"
                            asp-route-tagId="@tag.TagID"
                            class="badge bg-secondary text-decoration-none me-1">
                            @tag.TagName
                        </a>
                    }
                </div> *@
                </div>
            }
        </div>
    </div>
</div>