@model CraftDailyCorner.ViewModels.Announcement.VMAnnouncementList

@{
    ViewData["Title"] = "平台公告";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">平台公告</h2>
        <p class="text-muted mb-0">查看平台最新公告與重要通知</p>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="bi bi-megaphone fs-1 text-muted"></i>
                <div class="mt-3 text-muted">目前尚無公告</div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Items)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                <h5 class="card-title fw-bold mb-0">
                                    <a asp-controller="Announcement"
                                       asp-action="Detail"
                                       asp-route-id="@item.AnnouncementID"
                                       class="text-decoration-none text-soft-primary">
                                        @item.Title
                                    </a>
                                </h5>

                                <span class="text-muted small">
                                    @((item.PublishedAt ?? item.CreatedAt).ToString("yyyy/MM/dd HH:mm"))
                                </span>
                            </div>

                            <p class="card-text text-muted mb-3">
                                @item.ContentPreview
                            </p>

                            <a asp-controller="Announcement"
                               asp-action="Detail"
                               asp-route-id="@item.AnnouncementID"
                               class="btn btn-soft-primary btn-sm">
                                查看詳細
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>