@using CraftDailyCorner.ViewModels.Front.Member
@model List<VMMyOrder>

@{
    ViewData["Title"] = "我的訂單";

    // 訂單狀態 badge 顏色
    
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">我的訂單</h3>

        <a asp-controller="Member"
           asp-action="Index"
           asp-route-statusCode=""
           class="btn btn-outline-secondary btn-sm fs-5">
            <i class="bi bi-arrow-left"> </i>返回會員中心
        </a>
    </div>
    


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            目前尚無訂單紀錄
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>訂單編號</th>
                        <th>下單時間</th>
                        <th class="text-end">總金額</th>
                        <th>狀態</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    @order.OrderID
                                </span>
                            </td>

                            <td>
                                @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                            </td>

                            <td class="text-end">
                                <span class="fw-semibold">
                                    $@order.TotalAmount
                                </span>
                            </td>

                            <td>
                                @{
                                    string statusBadgeClass = order.StatusText switch
                                    {
                                        "待付款" => "bg-danger",   // 紅色
                                        "已付款" => "bg-success",   // 綠色
                                        "出貨中" => "bg-warning",   // 黃色
                                        "已完成" => "bg-primary",   // 藍色
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusBadgeClass">
                                    @order.StatusText
                                </span>
                            </td>

                            <td class="text-end">
                                <a asp-action="Detail"
                                   asp-route-orderId="@order.OrderID"
                                   class="btn btn-sm btn-outline-primary">
                                    查看明細
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    
</div>
