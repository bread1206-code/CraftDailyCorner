@using CraftDailyCorner.Services.Interface
@using CraftDailyCorner.ViewModels.Member
@model VMMyOrderDetail
@inject ISiteSettingService SiteSetting

@{
    var email = await SiteSetting.GetStringAsync("PlatformServiceEmail");
}
@{
    ViewData["Title"] = "訂單明細";

    int step = Model.StatusID switch
    {
        1 => 1, // 待付款
        2 => 2, // 已付款
        3 => 3, // 準備中
        4 => (Model.ShipmentStatusID == 3 ? 5 : 4), // 已出貨  //判斷商品是否已送達
        5 => 5, // 完成
        6 => 6, // 取消
        _ => 0
    };

    // 判斷狀態
    bool isPendingPayment = Model.StatusID == 1;
    bool isShipped = Model.StatusID == 4;
    bool isCompleted = Model.StatusID == 5;
    bool isCancelled = Model.StatusID == 6;

    // 根據狀態設定 Banner 樣式
    string bannerClass = "alert-success";
    string iconClass = "bi-check-circle";
    string subMessage = "此訂單已完成付款，感謝您的購買";


    if (isPendingPayment)
    {
        bannerClass = "alert-warning";
        iconClass = "bi-exclamation-circle";
        subMessage = "此訂單尚未完成付款，請於下方進行付款";
    }
    else if (isShipped)
    {
        bannerClass = "alert-info";
        iconClass = "bi-truck";

        if (Model.ShipmentStatusID == 3)
        {
            subMessage = "您的訂單已送達，請於規定時間內完成取貨";
        }
        else
        {
            subMessage = "您的訂單已出貨，請耐心等待配送";
        }
    }
    else if (isCompleted)
    {
        bannerClass = "alert-success";
        iconClass = "bi-check-circle-fill";
        subMessage = "此訂單已完成，感謝您的購買！";
    }else if (isCancelled)
    {
        bannerClass = "alert-secondary";
        iconClass = "bi-x-circle";
        subMessage = "此訂單已取消，相關商品庫存已釋出，歡迎重新選購。";
    }

    // 訂單狀態 badge 顏色
    string statusBadgeClass = Model.StatusText switch
    {
        "待付款" => "bg-danger",   // 紅色
        "已付款" => "bg-success",   // 綠色
        "準備中" => "bg-success",   
        "已出貨" => "bg-warning",   // 黃色
        "完成" => "bg-primary",   // 藍色
        _ => "bg-secondary"
    };
}
@if (TempData["OrdersError"] != null)
{
    <div class="alert alert-danger">
        @TempData["OrdersError"]
    </div>
}

@if (TempData["OrdersSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["OrdersSuccess"]
    </div>
}
<div class="container my-5">

    <!-- ===== 標題列 ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">訂單明細</h3>

        <a asp-action="Index"
           class="btn btn-soft-secondary btn-sm fs-5">
            返回我的訂單
        </a>
    </div>

    <!-- ===== 訂單狀態 Banner ===== -->
    <div class="alert @bannerClass d-flex align-items-center mb-4 shadow-sm">
        <i class="bi @iconClass fs-4 me-3"></i>
        <div>
            <div class="fw-semibold fs-5">
                @Model.StatusText
            </div>
            <small class="text-muted fs-6">
                @subMessage
            </small>
        </div>
    </div>

    <!-- ===== 訂單狀態進度條 ===== -->
    @if (Model.StatusID != 6)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="order-progress">
                    <div class="step @(step >= 1 ? "active" : "")">
                        <div class="circle">1</div>
                        <div class="label">已下單<br /><small>建立訂單</small></div>
                    </div>

                    <div class="line @(step >= 2 ? "active" : "")"></div>

                    <div class="step @(step >= 2 ? "active" : "")">
                        <div class="circle">2</div>
                        <div class="label">已付款<br /><small>付款完成</small></div>
                    </div>

                    <div class="line @(step >= 3 ? "active" : "")"></div>

                    <div class="step @(step >= 3 ? "active" : "")">
                        <div class="circle">3</div>
                        <div class="label">準備中<br /><small>訂單準備中</small></div>
                    </div>

                    <div class="line @(step >= 4 ? "active" : "")"></div>

                    <div class="step @(step >= 4 ? "active" : "")">
                        <div class="circle">4</div>
                        <div class="label">配送中<br /><small>商品寄出</small></div>
                    </div>

                    <div class="line @(step >= 5 ? "active" : "")"></div>

                    <div class="step @(step >= 5 ? "active" : "")">
                        <div class="circle">5</div>
                        <div class="label">已完成<br /><small>完成收貨</small></div>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- ===== 訂單基本資訊 ===== -->
    @{
        // 只要進入配送中，就切成 4/4/4 並顯示右側動作區
        bool showAction = (Model.StatusID == 4);

        string colInfo = showAction ? "col-md-4" : "col-md-6";
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row gy-3 align-items-stretch">

                <!-- 訂單資訊 -->
                <div class="@colInfo">
                    <div class="fw-semibold">訂單編號</div>
                    <div class="text-muted">@Model.OrderID</div>

                    <div class="fw-semibold mt-3">下單時間</div>
                    <div class="text-muted">
                        @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </div>

                    <div class="fw-semibold mt-3">訂單狀態</div>
                    <span class="badge @statusBadgeClass">
                        @Model.StatusText
                    </span>

                    @if (Model.DeliveredAt != null)
                    {
                        <div class="text-muted small mt-2">
                            送達時間：@Model.DeliveredAt?.ToString("yyyy/MM/dd HH:mm")
                        </div>
                    }
                </div>

                <!-- 收件資訊 -->
                <div class="@colInfo">
                    <div class="fw-semibold">收件人</div>
                    <div class="text-muted">@Model.ReceiverName</div>

                    <div class="fw-semibold mt-3">聯絡電話</div>
                    <div class="text-muted">@Model.ReceiverPhone</div>

                    <div class="fw-semibold mt-3">配送地址</div>
                    <div class="text-muted">@Model.ShippingAddress</div>
                </div>

                <!-- 動作區：只有特定條件才出現 -->
                @if (showAction)
                {
                    <div class="col-md-4 d-flex justify-content-md-end">
                        <div class="d-flex flex-column gap-2 w-100">

                            @* 配送中才顯示「取貨」 *@
                            @if (Model.StatusID == 4 && Model.ShipmentStatusID == 3)
                            {
                                <form asp-action="ConfirmPickup" method="post" class="d-flex justify-content-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@Model.OrderID" />

                                    <button type="submit" class="order-card-btn order-card-blue">
                                        <div class="card-icon">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div class="card-text">
                                            取貨（模擬）
                                        </div>
                                    </button>
                                </form>
                            }

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- ===== 訂單總金額 ===== -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body text-center">
            <div class="text-muted mb-1">訂單總金額</div>
            <div class="fs-2 fw-bold text-danger">
                NT$ @Model.TotalAmount.ToString("N0")
            </div>
            <!-- ===== 查看付款紀錄 ===== -->
            <button class="btn btn-soft-filter mt-2"
                    data-bs-toggle="collapse"
                    data-bs-target="#orderPaymentCollapse">
                查看此訂單的付款紀錄
            </button>
        </div>
    </div>
    <div class="collapse mt-3" id="orderPaymentCollapse">
        @await Html.PartialAsync("_OrderPaymentPartial", Model.OrderPayments)
    </div>
    <!-- ===== 商品明細 ===== -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body p-0">
            <table class="table mb-0 align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th>商品</th>
                        <th class="text-end">單價</th>
                        <th class="text-end">數量</th>
                        <th class="text-end">小計</th>
                        @if (Model.StatusID == 5)
                        {
                            <th class="text-end">評價</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>

                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.ProductImagePath"
                                         alt="@item.ProductName"
                                         class="rounded border flex-shrink-0"
                                         style="width:72px; height:72px; object-fit:cover;" />

                                    <div>
                                        <div class="fw-semibold">@item.ProductName</div>
                                        <small class="text-muted">創作者：@item.BrandName</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">$@item.Price</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end fw-semibold">$@item.SubTotal</td>

                            @if (Model.StatusID == 5)
                            {
                                <td class="text-end">
                                    <button type="button"
                                            class="btn @(item.HasReview ? "btn-soft-secondary" : "btn-soft-primary") btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#productReviewModal"
                                            data-order-id="@Model.OrderID"
                                            data-product-id="@item.ProductID"
                                            data-product-name="@item.ProductName"
                                            data-review-id="@item.ReviewID"
                                            data-rating="@item.ReviewRating"
                                            data-comment="@item.ReviewComment"
                                            data-has-review="@item.HasReview.ToString().ToLower()">
                                        @(item.HasReview ? "編輯評價" : "建立評價")
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===== 付款主行動 ===== -->
    <div class="text-center my-5">
        @if (Model.StatusID == 1) @* 待付款 *@
        {
            <a asp-controller="Payment"
               asp-action="Create"
               asp-route-orderId="@Model.OrderID"
               class="btn btn-primary btn-lg px-5 py-3 shadow me-3">
                <i class="bi bi-credit-card me-2"></i>
                前往付款
            </a>
            <div class="text-muted small mt-2">
                支援多種付款方式，安全快速
            </div>

            <form asp-action="Cancel" method="post" class="d-inline"
                  onsubmit="return confirm('確定要取消這筆訂單嗎？')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.OrderID" />
                <button type="submit" class="btn btn-outline-danger btn-lg px-4 py-3">
                    取消訂單
                </button>
            </form>
        }
        else if (Model.StatusID == 6)
        {
            <div class="alert alert-secondary text-center shadow-sm py-4">
                <i class="bi bi-x-circle-fill fs-3 d-block mb-2"></i>
                <span class="fs-5">此訂單已取消，相關商品庫存已釋出，歡迎重新選購。</span>
            </div>
        }
        else
        {
            @if (Model.StatusID != 5)
            {
                <div class="alert alert-success text-center shadow-sm">
                    <i class="bi bi-check-circle-fill fs-3 me-2"></i>
                    此訂單已付款，系統正持續處理中
                </div>                
            }
        }
    </div>

    <!-- ===== 客服資訊 ===== -->
    <div class="alert alert-light mt-4">
        <div class="fw-semibold mb-1">訂單有問題？</div>
        <small class="text-muted">
            若您對訂單內容或配送狀態有任何疑問，請聯絡客服：
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <a href="mailto:@email">@email</a>
            }
            else
            {
                <span>目前尚未設定客服信箱</span>
            }
        </small>
    </div>
    @if (Model.StatusID == 5)
    {
        <div class="modal fade" id="productReviewModal" tabindex="-1" aria-labelledby="productReviewModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-controller="ProductReviews" asp-action="Upsert" method="post">
                        @Html.AntiForgeryToken()

                        <div class="modal-header">
                            <h5 class="modal-title" id="productReviewModalLabel">商品評價</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                        </div>

                        <div class="modal-body">
                            <input type="hidden" name="OrderID" id="reviewOrderID" />
                            <input type="hidden" name="ProductID" id="reviewProductID" />
                            <input type="hidden" name="ReviewID" id="reviewID" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">商品名稱</label>
                                <input type="text" id="reviewProductName" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label for="reviewRating" class="form-label fw-semibold">星等</label>
                                <select name="Rating" id="reviewRating" class="form-select" required>
                                    <option value="">請選擇星等</option>
                                    <option value="5">5 星</option>
                                    <option value="4">4 星</option>
                                    <option value="3">3 星</option>
                                    <option value="2">2 星</option>
                                    <option value="1">1 星</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="reviewComment" class="form-label fw-semibold">評論內容</label>
                                <textarea name="Comment" id="reviewComment" class="form-control" rows="4" maxlength="1000"
                                          placeholder="歡迎分享您對商品的使用感受"></textarea>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">取消</button>
                            <button type="submit" class="btn btn-soft-primary" id="reviewSubmitButton">儲存評價</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@if (Model.StatusID == 5)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const reviewModal = document.getElementById("productReviewModal");
            if (!reviewModal) return;

            reviewModal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;

                const orderId = button.getAttribute("data-order-id");
                const productId = button.getAttribute("data-product-id");
                const productName = button.getAttribute("data-product-name");
                const reviewId = button.getAttribute("data-review-id");
                const rating = button.getAttribute("data-rating");
                const comment = button.getAttribute("data-comment");
                const hasReview = button.getAttribute("data-has-review") === "true";

                document.getElementById("reviewOrderID").value = orderId ?? "";
                document.getElementById("reviewProductID").value = productId ?? "";
                document.getElementById("reviewID").value = reviewId ?? "";
                document.getElementById("reviewProductName").value = productName ?? "";
                document.getElementById("reviewRating").value = rating ?? "";
                document.getElementById("reviewComment").value = comment ?? "";

                document.getElementById("productReviewModalLabel").textContent =
                    hasReview ? "編輯商品評價" : "建立商品評價";

                document.getElementById("reviewSubmitButton").textContent =
                    hasReview ? "儲存修改" : "送出評價";
            });
        });
    </script>
}