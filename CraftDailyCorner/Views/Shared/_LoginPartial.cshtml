@using CraftDailyCorner.ViewModels.Front
@using CraftDailyCorner.ViewModels.Front.Member
@model VMLogin

@{
    if (Model != null &&
        Context.Request.Cookies.TryGetValue("RememberAccount", out string account))
    {
        Model.Account = account;
        Model.RememberAccount = true;
    }
}

<form id="loginForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="" />

    <!-- 錯誤訊息 -->
    <div id="loginError"
         class="alert alert-danger d-none">
    </div>

    <!-- Account -->
    <div class="mb-3">
        <label asp-for="Account" class="form-label"></label>
        <input asp-for="Account"
               class="form-control"
               placeholder="請輸入 Email 或 手機號碼"
               autocomplete="username" />
    </div>

    <!-- Password -->
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password"
               type="password"
               class="form-control"
               placeholder="請輸入密碼"
               autocomplete="current-password" />
    </div>

    <!-- Remember -->
    <div class="form-check mb-3">
        <input asp-for="RememberAccount"
               class="form-check-input" />
        <label asp-for="RememberAccount"
               class="form-check-label">
            記住帳號
        </label>
    </div>

    <div class="d-grid">
        <button type="button"
                class="btn btn-primary"
                onclick="ajaxLogin()">
            登入
        </button>
    </div>

    <div class="text-center mt-3">
        <span>尚未註冊？</span>
        <a href="#"
           onclick="switchToRegister(); return false;">
            立即註冊
        </a>
    </div>
    <div class="text-center mt-3">
        <span>忘記密碼？</span>
        <a asp-controller="Account"
           asp-action="ForgetPassword">
            重設密碼
        </a>
    </div>
</form>