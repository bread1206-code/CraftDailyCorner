@using CraftDailyCorner.ViewModels.Cart
@model List<VMCartItem>

@if (!Model.Any())
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-cart-x fs-1"></i>
        <p class="mt-2">購物車目前是空的</p>
    </div>
}
else
{
    <div id="cart-items-container">
        @* 按創作者分組 *@
        @foreach (var group in Model.GroupBy(x => new { x.CreatorId, x.BrandName }))
        {
            <div class="creator-group mb-4 border rounded">
                <div class="card-header bg-light d-flex align-items-center">
                    <input type="checkbox" class="form-check-input creator-check me-2"
                           data-creator-id="@group.Key.CreatorId"
                           id="check-@group.Key.CreatorId" />
                    <label class="fw-bold mb-0" for="check-@group.Key.CreatorId">
                        創作者：@group.Key.BrandName
                    </label>
                </div>

                <div class="list-group list-group-flush">
                    @foreach (var item in group)
                    {
                        <div class="list-group-item py-3">
                            <div class="row align-items-center">
                                <div class="col-1">
                                    <input type="checkbox" class="form-check-input product-check"
                                           data-creator-id="@group.Key.CreatorId"
                                           data-product-id="@item.ProductId" />
                                </div>

                                <div class="col-2">
                                    <img src=@($"/Photos/04ProductImage/Medium/{item.ImageUrl}.png") class="img-fluid rounded" />
                                </div>

                                <div class="col-4">
                                    <div class="fw-semibold">@item.ProductName</div>
                                    <small class="text-muted">$@item.PriceInt</small>
                                </div>

                                <div class="col-3">
                                    <div class="input-group input-group-sm">
                                        <button class="btn btn-outline-secondary" onclick="updateQuantity('@item.ProductId', @(item.Quantity - 1))">-</button>
                                        <input type="number" class="form-control text-center" value="@item.Quantity" readonly />
                                        <button class="btn btn-outline-secondary" onclick="updateQuantity('@item.ProductId', @(item.Quantity + 1))">+</button>
                                    </div>
                                </div>

                                <div class="col-2 text-end">
                                    <strong>$@item.SubTotal</strong>
                                    <button class="btn btn-sm btn-link text-danger" onclick="removeFromCart('@item.ProductId')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
        <span class="text-muted">已選擇 <span id="selected-count">0</span> 件商品</span>
        <div>
            <span class="me-3 fw-bold">總計: $<span id="selected-amount">0</span></span>
            <button id="checkout-btn" class="btn btn-primary" disabled onclick="goToCheckout()">
                前往結帳
            </button>
        </div>
    </div>
}