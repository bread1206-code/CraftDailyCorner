@using CraftDailyCorner.ViewModels.FollowCreator
@model VMFollowButton

<form class="follow-form"
      asp-controller="Follow"
      asp-action="Toggle"
      method="post"
      data-logo="@Model.LogoUrl">

    @Html.AntiForgeryToken()

    <input type="hidden" name="creatorId" value="@Model.CreatorID" />

    <button type="submit"
            class="btn follow-btn @(Model.IsFollowing ? "btn-soft-danger" : "btn-soft-warning")"
            aria-busy="false">
        <span class="follow-text">@(Model.IsFollowing ? "已追蹤" : "追蹤")</span>
        (<span class="follow-count">@Model.FollowerCount</span>)
    </button>
</form>