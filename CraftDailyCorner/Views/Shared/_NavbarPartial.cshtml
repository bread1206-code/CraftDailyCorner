@using CraftDailyCorner.Extensions
@using CraftDailyCorner.Services.Interface
@using CraftDailyCorner.ViewModels
@using System.Security.Claims
@inject ISiteSettingService SiteSetting
@inject IMessageService MessageService
@{
    bool hasUnread = false;
    var registrationEnabled = await SiteSetting.GetBoolAsync("RegistrationEnabled");
    var logoName = await SiteSetting.GetStringAsync("PlatformLogo");

    if (string.IsNullOrWhiteSpace(logoName))
    {
        logoName = "platformLogo";
    }

    if (User.Identity?.IsAuthenticated == true)
    {
        var memberId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var creatorId = User.GetCreatorId();

        if (!string.IsNullOrWhiteSpace(memberId))
        {
            hasUnread = await MessageService.HasUnreadMessagesAsync(memberId, creatorId);
        }
    }
}
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand me-3" asp-controller="Home" asp-action="Index">
            <img src="@($"/Photos/07LOGO/Other/{logoName}.png?v={DateTime.Now.Ticks}")"
                 alt="Logo"
                 class="Logo img-fluid" />
        </a>

        <!-- 手機版漢堡按鈕 -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            <!-- 主選單區 -->
            <ul class="navbar-nav align-items-lg-center gap-lg-2 mb-2 mb-lg-0">
                <!-- 音樂播放 -->
                <li class="nav-item position-relative music-control-wrapper">
                    <button class="btn btn-outline-secondary"
                            type="button"
                            id="musicToggleBtn"
                            title="播放 / 暫停背景音樂">
                        <i class="bi bi-play-fill" id="musicToggleIcon"></i>
                    </button>

                    <div class="music-hover-panel shadow-sm">
                        <button type="button"
                                class="music-panel-btn"
                                id="musicPrevBtn"
                                title="上一首">
                            <i class="bi bi-skip-backward-fill"></i>
                        </button>

                        <div class="music-volume-block" title="音量">
                            <input type="range"
                                   id="musicVolumeSlider"
                                   min="0"
                                   max="1"
                                   step="0.01"
                                   value="0.5"
                                   class="music-volume-slider" />
                        </div>

                        <button type="button"
                                class="music-panel-btn"
                                id="musicNextBtn"
                                title="下一首">
                            <i class="bi bi-skip-forward-fill"></i>
                        </button>
                    </div>
                </li>
                <!-- 探索創作 -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        探索創作
                    </a>

                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Post"
                               asp-action="Index">
                                <i class="bi bi-journal-text text-primary"></i>
                                創作日誌
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Portfolio"
                               asp-action="Index">
                                <i class="bi bi-grid-3x3-gap text-success"></i>
                                作品集
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Creator"
                               asp-action="Index">
                                <i class="bi bi-people text-secondary"></i>
                                創作者
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- 商品分類 -->
                <li class="nav-item dropdown position-static">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        商品分類
                    </a>
                    @await Component.InvokeAsync("VCCategoryDropdown")
                </li>
            </ul>

            <!-- 搜尋框 -->
            <form asp-controller="Products"
                  asp-action="Index"
                  method="get"
                  class="d-flex my-3 my-lg-0 mx-lg-auto navbar-search-form me-lg-3 me-xl-4">
                <input class="form-control me-2"
                       type="search"
                       name="keyword"
                       placeholder="搜尋商品"
                       value="@Context.Request.Query["keyword"]" />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <!-- 右側功能 -->
            <ul class="navbar-nav ms-lg-auto align-items-lg-center gap-2">

                <!-- 購物車 -->
                <li class="nav-item">
                    @{
                        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                        bool hideCartButton = ViewBag.HideCartButton == true;
                    }

                    @if (!hideCartButton)
                    {
                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <button class="btn btn-primary position-relative"
                                    type="button"
                                    onclick="prepareLoginModal(); openLoginModal();">
                                <i class="bi bi-cart"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary position-relative"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#CartModal">
                                <i class="bi bi-cart" id="cartIcon"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge"
                                      style="display:none">
                                    0
                                </span>
                            </button>
                        }
                    }
                </li>

                <!-- 通知 -->
                <li class="nav-item">
                    @await Component.InvokeAsync("VCNotificationDropdown")
                </li>

                <!-- 登入 / 使用者 -->
                @if (!User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <button class="btn btn-primary w-100 w-xl-auto"
                                type="button"
                                onclick="prepareLoginModal()"
                                data-bs-toggle="modal"
                                data-bs-target="#loginModal">

                            <!-- 平板 / 小桌機 -->
                            <span class="d-xl-none">
                                <i class="bi bi-person-square"></i>
                            </span>

                            <!-- 大桌機 -->
                            <span class="d-none d-xl-inline">
                                登入 / 註冊
                            </span>

                        </button>
                    </li>
                }
                else
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Hi, @User.Identity!.Name
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Orders"
                                   asp-action="Index">
                                    <i class="bi bi-box-seam text-primary"></i>
                                    我的訂單
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Payment"
                                   asp-action="Index">
                                    <i class="bi bi-clock-history text-secondary"></i>
                                    付款紀錄
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Member"
                                   asp-action="Favorites">
                                    <i class="bi bi-box2-heart text-danger"></i>
                                    收藏清單
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Member"
                                   asp-action="Follows">
                                    <i class="bi bi-bookmark-heart text-purple"></i>
                                    追蹤清單
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Member"
                                   asp-action="Index">
                                    <i class="bi bi-person-circle"></i>
                                    個人中心
                                </a>
                            </li>

                            @if (User.IsInRole("02")) // 創作者
                            {
                                <li>
                                    <a class="dropdown-item text-success"
                                       asp-controller="Creator"
                                       asp-action="Dashboard">
                                        <i class="bi bi-brush"></i>
                                        創作者中心
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("03") || User.IsInRole("04")) // 管理者
                            {
                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-area="Admin"
                                       asp-controller="Dashboard"
                                       asp-action="Index">
                                        <i class="bi bi-shield-lock"></i>
                                        管理者中心
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   asp-controller="Messages"
                                   asp-action="Index">
                                    <span>
                                        <i class="bi bi-chat-dots"></i>
                                        我的訊息
                                    </span>

                                    @if (hasUnread)
                                    {
                                        <span class="message-dot"></span>
                                    }
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Notification"
                                   asp-action="Preferences">
                                    <i class="bi bi-bell me-2"></i>通知設定
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    <i class="bi bi-door-open"></i>
                                    登出
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                
            </ul>
        </div>
    </div>
</nav>