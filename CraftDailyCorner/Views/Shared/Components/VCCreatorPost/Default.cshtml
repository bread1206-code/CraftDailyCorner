@using CraftDailyCorner.ViewModels
@using CraftDailyCorner.ViewModels.Homepage
@model IEnumerable<VMHotPostCard>
@{
    Layout = null;
}
<div class="card" id="hotpost">
    <div class="card-body">
        <h2 class="fw-bold mb-3"><i class="bi bi-book text-primary"> </i>精選創作者故事</h2>
        @if (Model.Any())
        {
            <div class="row smallimg px-3">
                @foreach (var item in Model)
                {
                    <div class="col-md-3 px-3">
                        <a asp-controller="Post" asp-action="Detail" asp-route-id="@item.PostID" class="text-decoration-none text-dark">
                            <div class="card hover-card p-2">
                                @if (item.ImageUrl != null)
                                {
                                    <img src="@($"/Photos/05CreatorPost/Medium/{item.ImageUrl}.png")" alt="Photo" class="img-thumbnail rounded-circle m-2" />
                                }
                                <div class="card-body p-0">
                                    <div class="fw-bold hotpost-title text-center"><i class="bi bi-filter-right"></i>@Html.DisplayFor(modelItem => item.Title)<i class="bi bi-filter-left"></i></div>
                                    <div class="fw-bold hotpost-Author text-end mx-2">
                                        <a asp-controller="Creator" asp-action="Profile" asp-route-id="@item.CreatorID" class="text-decoration-none text-success">
                                            @Html.DisplayFor(modelItem => item.DisplayName)
                                        </a>
                                        <div>@Html.DisplayFor(modelItem => item.CreatedAt)</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
