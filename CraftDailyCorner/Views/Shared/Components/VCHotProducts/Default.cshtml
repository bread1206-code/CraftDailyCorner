@using CraftDailyCorner.ViewModels
@using CraftDailyCorner.ViewModels.Homepage
@model IEnumerable<VMHotProductCard>

@{
    Layout = null;
}
<div class="card" id="hotproduct">
    <div class="card-body">
        <h2 class="fw-bold mb-1"><i class="bi bi-fire text-danger"> </i>發燒新品</h2>
        @if (Model.Any())
        {
            <div class="row smallimg px-3">
                @foreach (var item in Model)
                {
                    <div class="col-md-3 px-3">
                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@item.ProductID" class="text-decoration-none text-dark">
                    
                        <div class="card hover-card">
                            @if (item.CoverImage != null)
                            {
                                    <img src="@($"/Photos/04ProductImage/Medium/{item.CoverImage}.png")" alt="Photo" class="img-thumbnail" />
                            }
                            <div class="card-body">
                                <div>@Html.DisplayFor(modelItem => item.CreatorName)</div>
                                <div class="fw-bold fs-3 hotpost-title">@Html.DisplayFor(modelItem => item.ProductName)</div>
                            </div>
                            <div class="fw-bold fs-4 mx-1"><i class="bi bi-currency-dollar"></i>@Html.DisplayFor(modelItem => item.Price)</div>
                                <div class="text-end mx-1 mb-1">@Html.DisplayFor(modelItem => item.FavoriteCount)人收藏中</div>
                        </div>
                        </a>
                    </div>
                    
                }
            </div>
        }
    </div>
</div>