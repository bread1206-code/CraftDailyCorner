@model List<Category>

@{
    var parentCategories = Model
        .Where(c => c.ParentCategoryID == null)
        .ToList();
}

<ul class="dropdown-menu mega-menu p-4">
    <li class="container">
        <div class="row">

            @foreach (var parent in parentCategories)
            {
                var children = Model
                .Where(c => c.ParentCategoryID == parent.CategoryID)
                .ToList();

                <div class="col-6 col-md-4 col-lg-3 mb-3">
                    <div class="fw-bold border-bottom pb-2 mb-2 h5">
                        <i class="bi bi-caret-right"></i>
                        @parent.CategoryName
                        <i class="bi bi-caret-left"></i>
                    </div>

                    @if (children.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var child in children)
                            {
                                <li class="mb-1">
                                    <a class="dropdown-item px-0"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-categoryId="@child.CategoryID">
                                        @child.CategoryName
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

        </div>
    </li>
</ul>
