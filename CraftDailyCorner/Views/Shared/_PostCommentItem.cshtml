@using CraftDailyCorner.Extensions
@using CraftDailyCorner.Models.enums
@using CraftDailyCorner.ViewModels.CreatorPost
@using CraftDailyCorner.ViewModels.Report
@model VMPostCommentItem

<div id="comment-@Model.CommentID"
     class="comment-item border-bottom py-3 position-relative">

    <div class="d-flex align-items-start">

        <img src="@Model.AvatarPath"
             class="rounded-circle me-3"
             width="40" height="40" />

        <div class="flex-grow-1">

            <div class="d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center">
                    <div class="fw-semibold">
                        @Model.MemberName
                        <span class="text-muted small ms-2">
                            @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                        </span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true && !Model.IsOwner)
                    {
                        <div class="ms-2 dropdown">
                            <button class="btn btn-sm p-0 text-muted"
                                    data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                            </button>

                            <ul class="dropdown-menu">
                                <li>
                                    @if (Model.IsReportBanned)
                                    {
                                        <button class="dropdown-item text-muted d-flex align-items-center"
                                                type="button"
                                                disabled>
                                            <i class="bi bi-flag me-2"></i>檢舉
                                            <i class="bi bi-x-circle-fill text-danger ms-auto"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="dropdown-item"
                                                type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reportModal-Comment-@Model.CommentID">
                                            <i class="bi bi-flag me-2"></i>檢舉
                                        </button>
                                    }
                                </li>
                            </ul>
                        </div>

                        @if (!Model.IsReportBanned)
                        {
                            <partial name="_ReportModal"
                                     model="new VMReport
                                         {
                                             ReportType = ReportTargetType.Comment,
                                             TargetID = Model.CommentID
                                         }" />
                        }
                    }
                </div>

                <!-- Reaction 按鈕 -->
                <div>
                    @if (User.Identity?.IsAuthenticated == true && Model.ReactionButton != null)
                    {
                        <partial name="_ReactionButtonPartial"
                                 model="Model.ReactionButton" />
                    }
                </div>

            </div>

            <div class="mt-1 text-content">@Model.Content</div>

            <div class="reaction-summary-container mt-2 small">
                <div class="mt-2 small @(Model.ReactionButton?.TotalCount > 0 ? "" : "d-none")"
                     data-reaction-summary
                     data-target-type="Comment"
                     data-target-id="@Model.CommentID">
                    <partial name="_ReactionSummaryPartial"
                             model="Model.ReactionButton" />
                </div>
            </div>

        </div>
    </div>

</div>