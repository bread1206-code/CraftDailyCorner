@using CraftDailyCorner.Services.Interface
@using CraftDailyCorner.ViewModels.Member
@using System.Security.Claims
@inject ISiteSettingService SiteSetting

@{
    var registrationEnabled = await SiteSetting.GetBoolAsync("RegistrationEnabled");
    var serviceEmail = await SiteSetting.GetStringAsync("PlatformServiceEmail");

    if (string.IsNullOrWhiteSpace(serviceEmail))
    {
        serviceEmail = "目前尚未設定客服信箱";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CraftDailyCorner.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loadingOverlay.css" />
    <link rel="stylesheet" href="~/css/reaction.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <div id="navbarContainer">
            @await Html.PartialAsync("_NavbarPartial")
        </div>

        <!-- 登入 Modal -->
        <div class="modal fade" id="loginModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">會員登入</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <ul class="nav nav-tabs mb-3">
                            <li class="nav-item">
                                <button class="nav-link active"
                                        data-bs-toggle="tab"
                                        data-bs-target="#loginTab">
                                    登入
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link"
                                        data-bs-toggle="tab"
                                        data-bs-target="#registerTab">
                                    註冊
                                </button>
                            </li>
                        </ul>

                        <!-- Tab Content -->
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="loginTab">
                                @await Html.PartialAsync("_LoginPartial", new VMLogin())
                            </div>

                            <div class="tab-pane fade" id="registerTab">
                                @if (registrationEnabled)
                                {
                                    @await Html.PartialAsync("_RegisterPartial", new VMRegister())
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="bi bi-person-x fs-1 text-muted d-block mb-3"></i>

                                        <h5 class="text-muted mb-2">
                                            目前暫停開放會員註冊
                                        </h5>

                                        <p class="text-muted small mb-0">
                                            若有任何問題，請聯絡平台客服：
                                            @if (!string.IsNullOrWhiteSpace(serviceEmail) && serviceEmail != "目前尚未設定客服信箱")
                                            {
                                                <a href="mailto:@serviceEmail">@serviceEmail</a>
                                            }
                                            else
                                            {
                                                <span>@serviceEmail</span>
                                            }
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 購物車 Modal -->
        <div class="modal fade" id="CartModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@User.Identity?.Name 的購物車</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="cartModalBody">
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CraftDailyCorner - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            - <a asp-area="" asp-controller="Home" asp-action="About">About</a>
        </div>
    </footer>

    <!--動畫區塊-->
    <div id="favorite-stamp-overlay"></div>

    <!--檢舉動畫區塊-->
    <div id="report-stamp-overlay"></div>

    <!-- 登入成功動畫 Overlay -->
    <div id="login-anim-overlay" class="login-anim-overlay" aria-hidden="true">
        <!-- 信封 -->
        <div class="login-anim-envelope d-none">
            <i class="bi bi-envelope-fill login-anim-icon"></i>
            <div class="login-stamp">登入成功</div>
        </div>

        <!-- 氣球 -->
        <div class="login-anim-balloon d-none">
            <i class="bi bi-balloon-fill login-anim-icon"></i>
            <div class="balloon-pop-ring"></div>
        </div>
    </div>
    <audio id="globalAudio" preload="auto">
        您的瀏覽器不支援 audio。
    </audio>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <script>
        // 傳遞使用者登入狀態到 JavaScript
        window.isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

        // 傳遞是否開放註冊到 JavaScript
        window.registrationEnabled = @registrationEnabled.ToString().ToLower();
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/siteMusic.js" asp-append-version="true"></script>
    <script src="~/js/cart.js"></script>
    <script src="~/js/loadingOverlay.js"></script>
    @await Html.PartialAsync("_LoadingOverlayPartial")
    <script src="~/js/loadingAuto.js"></script>
    <script src="~/js/postComment.js" asp-append-version="true"></script>
    <script src="~/js/reaction.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>