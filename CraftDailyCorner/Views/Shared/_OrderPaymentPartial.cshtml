@using CraftDailyCorner.ViewModels.Front.Payment
@model VMOrderPaymentList

<div class="card mb-4 shadow-sm">
    <div class="card-body">

        <!-- 標題 -->
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-receipt fs-4 me-2 text-primary"></i>
            <h5 class="fw-bold mb-0">付款紀錄</h5>
        </div>

        @if (Model == null || Model.Payments == null || !Model.Payments.Any())
        {
            <div class="alert alert-light text-center mb-0">
                <i class="bi bi-info-circle me-1"></i>
                尚無付款紀錄
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>付款方式</th>
                            <th class="text-end">金額</th>
                            <th>狀態</th>
                            <th>建立時間</th>
                            <th>付款時間</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @p.MethodName
                                </td>

                                <td class="text-end">
                                    NT$ @p.Amount.ToString("N0")
                                </td>

                                <td>
                                    @if (p.PaidAt.HasValue)
                                    {
                                        <span class="badge bg-success">
                                            @p.StatusName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @p.StatusName
                                        </span>
                                    }
                            </td>

                            <td>
                                @p.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                            </td>

                            <td>
                                @(p.PaidAt.HasValue
                                                            ? p.PaidAt.Value.ToString("yyyy/MM/dd HH:mm")
                                                            : "-")
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Payments.Count > 1)
            {
                <div class="text-muted small mt-2">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    此訂單曾進行多次付款嘗試
                </div>
            }
        }
    </div>
</div>