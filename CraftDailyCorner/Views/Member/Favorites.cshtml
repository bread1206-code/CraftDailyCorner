@using CraftDailyCorner.ViewModels.Member
@model List<VMFavoriteProductItem>

@{
    ViewData["Title"] = "我的收藏";
}

<div class="container my-5" id="favorite-page">

    <!-- 標題 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">
            <i class="bi bi-box2-heart me-2 text-danger"> </i>
            我的收藏商品
        </h3>

        <a asp-controller="Member"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm fs-5">
            返回會員中心
        </a>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-heart fs-1"></i>
            <p class="mt-3">你還沒有收藏任何商品</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="card h-100 shadow-sm position-relative">

                        <a asp-controller="Products"
                            asp-action="Detail"
                           asp-route-id="@item.ProductID"
                           class="text-decoration-none text-dark">

                            <img src=@($"/Photos/04ProductImage/{item.CreatorID}/Large/{item.CoverImageUrl}.png")
                                 class="card-img-top"
                                 style="height:200px;object-fit:cover;" />
                        </a>
                        <div class="card-body">

                            <!-- 商品名稱 + 收藏（同一行） -->
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="card-title text-truncate mb-1 pe-2">
                                    @item.ProductName
                                </h6>

                                <button type="button"
                                        class="btn btn-sm p-0 border-0 bg-transparent favorite-btn focus-none"
                                        data-product-id="@item.ProductID"
                                        data-is-favorite="@item.IsFavorite.ToString().ToLower()"
                                        onclick="event.preventDefault(); event.stopPropagation();">
                                    <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                                </button>
                            </div>

                            <p class="text-danger fw-bold mb-1">
                                NT$ @Math.Floor(item.Price)
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>