@model CraftDailyCorner.ViewModels.Front.VMEditProfile

@{
    ViewData["Title"] = "個人資料";

    string avatarUrl = string.IsNullOrEmpty(Model.ImageUrl)
        ? "/Photos/01Member/Medium/default.png"
        : $"/Photos/01Member/Medium/{Model.ImageUrl}";
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">個人資料</h3>

        <a asp-action="Index"
           class="btn btn-sm btn-outline-secondary">
            ← 返回會員中心
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Profile"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MemberID" />
                <input type="hidden" asp-for="ImageUrl" />

                <!-- 頭像（可即時預覽） -->
                <div class="mb-4 text-center">

                    <img id="avatarPreview"
                         src="@avatarUrl"
                         class="rounded-circle border mb-3"
                         style="width:180px;height:180px;object-fit:cover;" />

                    <div class="d-flex flex-column align-items-center gap-1">
                        <input asp-for="AvatarFile"
                               type="file"
                               class="form-control"
                               accept="image/png,image/jpeg"
                               onchange="previewAvatar(this)"
                               style="max-width:280px;" />

                        <small class="text-muted">
                            建議比例 1:1，支援 JPG / PNG
                        </small>
                    </div>
                </div>

                <!--  顯示名稱  -->
                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" />
                    <span asp-validation-for="DisplayName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="text-end">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        儲存變更
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewAvatar(input) {
            if (!input.files || input.files.length === 0) {
                return;
            }

            const file = input.files[0];

            // 簡單防呆（前端 UX 用，後端仍會驗）
            if (!file.type.startsWith("image/")) {
                alert("請選擇圖片檔案");
                input.value = "";
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.getElementById("avatarPreview");
                img.src = e.target.result;
            };

            reader.readAsDataURL(file);
        }
    </script>
}