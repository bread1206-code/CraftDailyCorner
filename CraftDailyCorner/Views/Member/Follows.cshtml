@using CraftDailyCorner.ViewModels.Member
@model List<VMFollowingCreatorCard>

@{
    ViewData["Title"] = "我的追蹤";
}

<div class="container my-5">

    <!-- 標題 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">
            <i class="bi bi-bookmark-heart me-2 text-purple"> </i>
            我追蹤的創作者
        </h3>
        <a asp-controller="Member"
               asp-action="Index"
               class="btn btn-soft-secondary btn-sm fs-5">
            返回會員中心
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown fs-1 text-muted"></i>
            <p class="mt-3 text-muted">你目前還沒有追蹤任何創作者</p>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <!-- 創作者資訊 -->
                        <div class="card-body border-bottom text-center">

                            <a href="@item.CreatorProfileUrl" class="text-decoration-none text-dark">

                                <img src="@item.CreatorLogoPath"
                                     class="rounded-circle mb-2"
                                     style="width:80px;height:80px;object-fit:cover;" />

                                <h5 class="fw-semibold">
                                    @item.BrandName
                                </h5>

                            </a>
                        </div>

                        <div class="card-body">

                            <div class="row text-center">

                                <!-- 最新商品 -->
                                <div class="col-4">

                                    <small class="text-muted d-block mb-2">最新商品</small>

                                    @if (item.LatestProductId != null)
                                    {
                                        <a href="@item.LatestProductUrl"
                                               class="text-decoration-none text-dark">

                                            <img src="@item.LatestProductImagePath"
                                                 class="img-fluid rounded mb-2"
                                                 style="height:80px;object-fit:cover;" />

                                            <div class="small fw-semibold">
                                                @item.LatestProductName
                                            </div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">尚無商品</div>
                                    }

                                </div>

                                <!-- 最新日誌 -->
                                <div class="col-4">

                                    <small class="text-muted d-block mb-2">最新日誌</small>

                                    @if (item.LatestPostId != null)
                                    {
                                        <a href="@item.LatestPostUrl"
                                               class="text-decoration-none text-dark">

                                            <img src="@item.LatestPostImagePath"
                                                 class="img-fluid rounded mb-2"
                                                 style="height:80px;object-fit:cover;" />

                                            <div class="small fw-semibold">
                                                @item.LatestPostTitle
                                            </div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">尚無日誌</div>
                                    }

                                </div>

                                <!-- 最新作品集 -->
                                <div class="col-4">

                                    <small class="text-muted d-block mb-2">最新作品集</small>

                                    @if (item.LatestPortfolioId != null)
                                    {
                                        <a href="@item.LatestPortfolioUrl"
                                               class="text-decoration-none text-dark">

                                            <img src="@item.LatestPortfolioImagePath"
                                                 class="img-fluid rounded mb-2"
                                                 style="height:80px;object-fit:cover;" />

                                            <div class="small fw-semibold">
                                                @item.LatestPortfolioTitle
                                            </div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">尚無作品</div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>