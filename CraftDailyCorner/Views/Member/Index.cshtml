@using CraftDailyCorner.ViewModels.Member
@model VMMemberDashboard

@{
    ViewData["Title"] = "個人中心";

    string avatarUrl = string.IsNullOrEmpty(Model.ImageUrl)
        ? "/Photos/01Member/Medium//default.webp"
        : $"/Photos/01Member/Medium/{Model.ImageUrl}.webp";
}
@if (TempData["CreatorApplicationWarning"] != null)
{
    <div class="alert alert-warning">@TempData["CreatorApplicationWarning"]</div>
}
@if (TempData["CreatorApplicationSuccess"] != null)
{
    <div class="alert alert-success">@TempData["CreatorApplicationSuccess"]</div>
}
<div class="container my-5">
    
    <!-- ===== 會員識別區（左：會員資訊｜右：創作者申請） ===== -->
    <div class="row g-4 mb-5">

        <!-- 左側：會員識別（col-8） -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">

                <div class="card-body d-flex align-items-center gap-4">

                    <img src="@avatarUrl"
                         alt="會員頭像"
                         class="rounded-circle border"
                         style="width:96px;height:96px;object-fit:cover;" />

                    <div>
                        <h4 class="fw-bold mb-1">
                            @Model.DisplayName
                        </h4>

                        <p class="text-muted mb-2">
                            <i class="bi bi-calendar-heart me-2"></i>加入時間：@Model.CreatedAt.ToString("yyyy 年 MM 月 dd 日")
                        </p>

                        <a asp-action="Profile"
                           class="btn btn-sm btn-soft-filter mt-2">
                            編輯個人資料
                        </a>
                        <a asp-controller="Member" asp-action="ChangePassword" class="btn  btn-sm btn-soft-filter mt-2">
                            修改密碼
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- 右側：申請成為創作者（col-4） -->
        <div class="col-md-4">
            <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column justify-content-center">

                    @* ===== 1. 已是創作者 ===== *@
                    @if (Model.IsCreator)
                    {
                        <div class="mb-2">
                            <i class="bi bi-check-circle fs-1 text-success"></i>
                        </div>
                        <div class="fs-4 fw-semibold mb-1">你已是創作者</div>
                        <p class="text-muted small mb-3">可以開始上架作品，分享你的創作</p>

                        <a asp-controller="Creator"
                           asp-action="Dashboard"
                           class="btn btn-success btn-sm fs-5">
                            前往創作者專區
                        </a>
                    }
                    @* ===== 2. 申請審核中 (Pending) ===== *@
                    else if (Model.CreatorApplicationStatusCode == "Pending")
                    {
                        <div class="mb-2">
                            <i class="bi bi-hourglass-split fs-1 text-warning"></i>
                        </div>
                        <div class="fs-4 fw-semibold mb-1">申請審核中</div>
                        <p class="text-muted small mb-3">我們正在審核你的申請，請耐心等候</p>

                        <button class="btn btn-soft-secondary btn-sm fs-5" disabled>
                            審核中
                        </button>
                    }
                    @* ===== 已通過 (Approved) 且還不是創作者：去確認頁 ===== *@
                    else if (Model.CreatorApplicationStatusCode == "Approved")
                    {
                        <div class="mb-2">
                            <i class="bi bi-award fs-1 text-success"></i>
                        </div>
                        <div class="fs-4 fw-semibold mb-1">恭喜審核通過！</div>
                        <p class="text-muted small mb-3">完成最後資料填寫即可開通創作者功能</p>

                        <a asp-controller="Creator"
                           asp-action="ApprovedConfirm"
                           asp-route-applicationId="@Model.CreatorApplicationId"
                           class="btn btn-soft-success btn-sm fs-5">
                            前往確認
                        </a>
                    }
                    @* ===== 已拒絕 (Rejected)：去拒絕確認頁 ===== *@
                    else if (Model.CreatorApplicationStatusCode == "Rejected")
                    {
                        <div class="mb-2">
                            <i class="bi bi-emoji-frown fs-1 text-secondary"></i>
                        </div>
                        <div class="fs-4 fw-semibold mb-1">很可惜，未通過審核</div>
                        <p class="text-muted small mb-3">您可以先查看原因並確認結果</p>

                        <a asp-controller="Creator"
                           asp-action="RejectedConfirm"
                           asp-route-applicationId="@Model.CreatorApplicationId"
                           class="btn btn-soft-primary btn-sm fs-5">
                            查看結果
                        </a>
                    }
                    @* =====  尚未申請  ===== *@
                    else
                    {
                        <div class="stat-icon-wrapper mb-2">
                            <i class="bi bi-stars fs-1 text-warning"></i>
                        </div>
                        <div class="fs-4 fw-semibold mb-1">成為創作者</div>
                        <p class="text-muted small mb-3">上架作品、分享創作，讓更多人看見你的創意</p>

                        <a asp-controller="Creator"
                           asp-action="Apply"
                           class="btn text-white rounded-pill btn-sm fs-5"
                           style="background-color: var(--bs-primary);">
                            申請成為創作者
                        </a>
                    }

                </div>
            </div>
        </div>
    </div>


    <!--  統計卡片  -->
    <div class="row g-4 mb-5">
        <!-- 待付款 -->
        <div class="col-md-4">
        <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center">
                <div class="stat-icon-wrapper mb-2 text-danger">
                        <i class="bi bi-credit-card fs-1 "></i>
                    </div>
                    <div class="fs-4 fw-semibold">
                        待付款訂單
                    </div>
                    <div class="fs-2 fw-bold text-danger">
                        @Model.PendingPaymentCount
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-statusCode="padding"
                       class="btn btn-outline-danger btn-sm fs-5">
                        前往付款
                    </a>
                </div>
            </div>
        </div>
        <!-- 進行中的訂單 -->
        <div class="col-md-4">
        <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center">
                <div class="stat-icon-wrapper mb-2">
                        <i class="bi bi-box-seam fs-1 text-primary"></i>
                    </div>
                    <div class="fs-4 fw-semibold">
                        進行中的訂單
                    </div>
                    <div class="fs-2 fw-bold">
                        @Model.OrderCount
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-statusCode="processing"
                       class="btn btn-outline-primary btn-sm fs-5">
                        查看訂單
                    </a>
                </div>
            </div>
        </div>
        <!-- 我的訂單紀錄 -->
        <div class="col-md-4">
        <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center">
                <div class="stat-icon-wrapper mb-2">
                        <i class="bi bi-check-circle fs-1 text-success"></i>
                    </div>
                    <div class="fs-4 fw-semibold">
                        我的訂單紀錄
                    </div>
                    <div class="fs-2 fw-bold text-success">
                        @Model.AllOrderCount
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-statusCode=""
                       class="btn btn-outline-success btn-sm fs-5">
                        查看紀錄
                    </a>
                </div>
            </div>
        </div>
        <!-- 我的追蹤 -->
        <div class="col-md-4">
        <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center">
                <div class="stat-icon-wrapper mb-2">
                        <i class="bi bi-bookmark-heart fs-1 text-purple"></i>
                    </div>
                    <div class="fs-4 fw-semibold">
                        我追蹤的創作者
                    </div>
                    <div class="fs-2 fw-bold text-purple">
                        @Model.FollowingCount
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                <a asp-controller="Member"
                   asp-action="Follows"
                       class="btn btn-outline-purple btn-sm fs-5">
                        查看追蹤
                    </a>
                </div>
            </div>
        </div>
        <!-- 我的收藏 -->
        <div class="col-md-4">
        <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center">
                <div class="stat-icon-wrapper mb-2">
                        <i class="bi bi-box2-heart fs-1 text-danger"></i>
                    </div>
                    <div class="fs-4 fw-semibold">
                        我收藏的商品
                    </div>
                    <div class="fs-2 fw-bold text-danger">
                        @Model.FavoriteCount
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                    <a asp-controller="Member"
                       asp-action="Favorites"
                       class="btn btn-outline-danger btn-sm fs-5">
                        查看收藏
                    </a>
                </div>
            </div>
        </div>
        <!-- 付款紀錄 -->
        <div class="col-md-4">
        <div class="card hover-card h-100 shadow-sm">
                <div class="card-body text-center">
                <div class="stat-icon-wrapper mb-2">
                        <i class="bi bi-clock-history fs-1 text-secondary"></i>
                    </div>
                    <div class="fs-4 fw-semibold">
                        付款紀錄
                    </div>
                    <div class="fs-2 fw-bold text-secondary">
                        @Model.PaymentCount
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center">
                    <a asp-controller="Payment"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-sm fs-5">
                        查看紀錄
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>