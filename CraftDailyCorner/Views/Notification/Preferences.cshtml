@model CraftDailyCorner.ViewModels.Notification.VMNotificationPreference

@{
    ViewData["Title"] = "通知設定";
}

<div class="container py-4" style="max-width: 720px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">通知設定</h2>
            <p class="text-muted mb-0">設定您想接收的通知類型</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Notification"
                  asp-action="Preferences"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="form-check form-switch mb-4">
                    <input asp-for="ProductNotificationEnabled" class="form-check-input" />
                    <label asp-for="ProductNotificationEnabled" class="form-check-label fw-semibold"></label>
                    <div class="form-text">
                        當您收藏的商品重新上架或有相關異動時，通知您。
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="OrderNotificationEnabled" class="form-check-input" />
                    <label asp-for="OrderNotificationEnabled" class="form-check-label fw-semibold"></label>
                    <div class="form-text">
                        當訂單成立、出貨或狀態更新時，通知您。
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="CreatorNotificationEnabled" class="form-check-input" />
                    <label asp-for="CreatorNotificationEnabled" class="form-check-label fw-semibold"></label>
                    <div class="form-text">
                        當您追蹤的創作者發布新創作日誌時，通知您。
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="text-end">
                    <a asp-controller="Notification"
                           asp-action="Index"
                           class="btn btn-soft-secondary">
                        返回我的通知
                    </a>
                    <button type="submit" class="btn btn-soft-primary">
                        <i class="bi bi-save2 me-1"></i> 儲存設定
                    </button>

                    
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}