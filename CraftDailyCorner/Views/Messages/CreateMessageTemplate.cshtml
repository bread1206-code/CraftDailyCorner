@model CraftDailyCorner.ViewModels.Message.VMMessageTemplateUpsert
@using CraftDailyCorner.Models.enums;

@{
    ViewData["Title"] = "新增快速回覆模板";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">新增快速回覆模板</h2>
                    <p class="text-muted mb-0">建立可在聊天中快速帶入的回覆內容</p>
                </div>

                <a asp-controller="Messages"
                   asp-action="MessageTemplates"
                   class="btn btn-outline-secondary">
                    返回列表
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-controller="Messages"
                          asp-action="CreateMessageTemplate"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="alert alert-info">
                            快速回覆模板最多只能建立 10 個。
                        </div>
                        @* 固定建立 QuickReply，不提供使用者切換 *@
                        <input type="hidden"
                               asp-for="TriggerType"
                               value="@AutoReplyTemplateTriggerType.QuickReply" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">模板類型</label>
                            <input class="form-control" value="快速回覆模板" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">儲存</button>
                            <a asp-controller="Messages"
                               asp-action="MessageTemplates"
                               class="btn btn-outline-secondary">返回列表</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}