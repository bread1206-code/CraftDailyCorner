@model CraftDailyCorner.ViewModels.Message.VMMessageTemplateUpsert
@using CraftDailyCorner.Models.enums;

@{
    ViewData["Title"] = "編輯訊息模板";

    var triggerTypeName = Model.TriggerType == AutoReplyTemplateTriggerType.FirstMessage
        ? "第一次訊息自動回覆"
        : "快速回覆模板";

    var pageSubtitle = Model.TriggerType == AutoReplyTemplateTriggerType.FirstMessage
        ? "此模板為系統固定模板，只能編輯、啟用 / 禁用"
        : "可修改快速回覆模板內容與啟用狀態";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">編輯訊息模板</h2>
                    <p class="text-muted mb-0">@pageSubtitle</p>
                </div>

                <a asp-controller="Messages"
                   asp-action="MessageTemplates"
                   class="btn btn-soft-secondary">
                    返回列表
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-controller="Messages"
                          asp-action="EditMessageTemplate"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="TemplateID" />
                        <input type="hidden" asp-for="TriggerType" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">模板類型</label>
                            <input class="form-control" value="@triggerTypeName" disabled />
                            <div class="form-text">
                                模板類型不可修改
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>

                        <div class="text-end">
                            <a asp-controller="Messages"
                               asp-action="MessageTemplates"
                               class="btn btn-soft-secondary">返回列表</a>
                            <button type="submit" class="btn btn-soft-primary ms-2">儲存</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}