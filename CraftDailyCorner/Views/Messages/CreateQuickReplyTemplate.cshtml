@model CraftDailyCorner.ViewModels.Message.VMMessageTemplateUpsert

@{
    ViewData["Title"] = "新增快速回覆模板";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">新增快速回覆模板</h2>
        <p class="text-muted mb-0">建立聊天頁可快速套用的模板</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-controller="Messages"
                  asp-action="CreateQuickReplyTemplate"
                  method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <a asp-controller="Messages"
                       asp-action="QuickReplyTemplates"
                       class="btn btn-outline-secondary">返回列表</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}