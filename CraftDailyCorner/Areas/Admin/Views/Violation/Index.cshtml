@model CraftDailyCorner.Areas.Admin.ViewModels.Violation.VMAdminViolationIndex

@{
    var isHistory = Model.Mode == "history";

    ViewData["Title"] = isHistory
        ? "違規管理（歷史資料）"
        : "違規管理";

    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">違規管理</h2>
            <div class="text-light opacity-75">
                @(isHistory ? "歷史檢舉資料（已判定）" : "待審核檢舉清單")
            </div>
        </div>

        @if (isHistory)
        {
            <div class="d-flex align-items-center gap-2">
                <form method="get"
                      asp-area="Admin"
                      asp-controller="Violation"
                      asp-action="Index"
                      class="d-flex gap-2 align-items-center justify-content-center"
                      style="min-width:520px;">

                    <input type="hidden" name="mode" value="history" />

                    <div class="input-group" style="width:300px;">
                        <span class="input-group-text bg-dark text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>

                        <input name="memberId"
                               value="@Model.SearchMemberId"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="輸入 MemberID 查詢（檢舉人/被檢舉者）" />
                    </div>

                    <button class="btn btn-outline-light" type="submit">
                        搜尋
                    </button>

                    <a class="btn btn-outline-secondary @(string.IsNullOrWhiteSpace(Model.SearchMemberId) ? "invisible" : "")"
                       asp-area="Admin"
                       asp-controller="Violation"
                       asp-action="Index"
                       asp-route-mode="history">
                        清除
                    </a>
                </form>
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-secondary"
                   asp-area="Admin"
                   asp-controller="Violation"
                   asp-action="Index"
                   asp-route-mode="history">
                    查看歷史資料
                </a>

                <span class="badge bg-danger @(Model.Items.Count == 0 ? "d-none" : "")">
                    待審核 @Model.Items.Count
                </span>
            </div>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Items.Any())
            {
                <div class="p-4 text-center text-light opacity-75">
                    <i class="bi bi-inbox fs-2"></i>
                    <div class="mt-2">
                        @(isHistory ? "沒有符合條件的歷史資料" : "目前沒有待審核檢舉")
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:120px;">檢舉ID</th>
                                <th>檢舉人</th>
                                <th>被檢舉者</th>
                                <th style="width:220px;">目標</th>
                                <th style="width:160px;">原因</th>

                                @if (isHistory)
                                {
                                    <th style="width:140px;">結果</th>
                                }

                                <th style="width:180px;">時間</th>
                                <th style="width:120px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Items)
                            {
                                var rowClass = isHistory ? "" : "table-active";
                                var resultBadge = x.StatusID == 2 ? "bg-danger"
                                : x.StatusID == 3 ? "bg-success"
                                : "bg-secondary";

                                <tr class="@rowClass">
                                    <td>#@x.ReportID</td>
                                    <td>
                                        <div class="fw-semibold">@x.ReporterName</div>
                                        <div class="small text-light opacity-75">@x.ReporterMemberID</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(x.TargetOwnerID))
                                        {
                                            <div class="fw-semibold">@x.TargetOwnerName</div>
                                            <div class="small text-light opacity-75">@x.TargetOwnerID</div>
                                        }
                                        else
                                        {
                                            <span class="text-light opacity-75">（未知）</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@x.TargetTypeName</div>
                                        <div class="small text-light opacity-75">@x.TargetID</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@x.ReasonName</span>
                                    </td>

                                    @if (isHistory)
                                    {
                                        <td>
                                            <span class="badge @resultBadge">@x.StatusName</span>
                                        </td>
                                    }

                                    <td>@x.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-light"
                                           asp-area="Admin"
                                           asp-controller="Violation"
                                           asp-action="Detail"
                                           asp-route-id="@x.ReportID">
                                            查看
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (isHistory && Model.TotalPages > 1)
                {
                    <div class="p-3 border-top border-secondary d-flex justify-content-between align-items-center">
                        <div class="text-secondary opacity-75 small">
                            第 @Model.Page / @Model.TotalPages 頁，共 @Model.TotalCount 筆
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @{
                                    var prev = Model.Page - 1;
                                    var next = Model.Page + 1;
                                    string memberId = Model.SearchMemberId ?? "";
                                }

                                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link bg-dark text-light border-secondary"
                                       asp-area="Admin"
                                       asp-controller="Violation"
                                       asp-action="Index"
                                       asp-route-mode="history"
                                       asp-route-memberId="@memberId"
                                       asp-route-page="@prev">
                                        上一頁
                                    </a>
                                </li>

                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.Page ? "active" : "")">
                                        <a class="page-link bg-dark text-light border-secondary"
                                           asp-area="Admin"
                                           asp-controller="Violation"
                                           asp-action="Index"
                                           asp-route-mode="history"
                                           asp-route-memberId="@memberId"
                                           asp-route-page="@p">
                                            @p
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link bg-dark text-light border-secondary"
                                       asp-area="Admin"
                                       asp-controller="Violation"
                                       asp-action="Index"
                                       asp-route-mode="history"
                                       asp-route-memberId="@memberId"
                                       asp-route-page="@next">
                                        下一頁
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }

        </div>
    </div>

</div>