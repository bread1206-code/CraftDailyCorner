@model CraftDailyCorner.Areas.Admin.ViewModels.Violation.VMAdminViolationIndex

@{
    ViewData["Title"] = "違規管理";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">違規管理</h2>
            <div class="text-light opacity-75">待審核檢舉清單</div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-sm btn-outline-secondary"
               asp-area="Admin"
               asp-controller="Violation"
               asp-action="Index"
               asp-route-mode="history">
                查看歷史資料
            </a>

            <span class="badge bg-danger @(Model.Items.Count == 0 ? "d-none" : "")">
                待審核 @Model.Items.Count
            </span>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Items.Any())
            {
                <div class="p-4 text-center text-light opacity-75">
                    <i class="bi bi-inbox fs-2"></i>
                    <div class="mt-2">目前沒有待審核檢舉</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:120px;">檢舉ID</th>
                                <th>檢舉人</th>
                                <th>被檢舉者</th>
                                <th style="width:220px;">目標</th>
                                <th style="width:160px;">原因</th>
                                <th style="width:180px;">時間</th>
                                <th style="width:120px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Items)
                            {
                                <tr class="table-active">
                                    <td>#@x.ReportID</td>
                                    <td>
                                        <div class="fw-semibold">@x.ReporterName</div>
                                        <div class="small text-light opacity-75">@x.ReporterMemberID</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(x.TargetOwnerID))
                                        {
                                            <div class="fw-semibold">@x.TargetOwnerName</div>
                                            <div class="small text-light opacity-75">@x.TargetOwnerID</div>
                                        }
                                        else
                                        {
                                            <span class="text-light opacity-75">（未知）</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@x.TargetTypeName</div>
                                        <div class="small text-light opacity-75">@x.TargetID</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@x.ReasonName</span>
                                    </td>
                                    <td>@x.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-light"
                                           asp-area="Admin"
                                           asp-controller="Violation"
                                           asp-action="Detail"
                                           asp-route-id="@x.ReportID">
                                            查看
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>