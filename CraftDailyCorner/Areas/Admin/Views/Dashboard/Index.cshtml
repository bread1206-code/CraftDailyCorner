@model CraftDailyCorner.Areas.Admin.ViewModels.VMDashboard

@{
    ViewData["Title"] = "儀表板";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- ================= KPI 區 ================= -->
    <div class="row g-4 mb-4">

        <!-- 今日訂單 -->
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="kpi-title">訂單數</div>
                    <div class="kpi-grid">
                        <div>
                            <div class="kpi-label">今日</div>
                            <div class="kpi-value">@Model.TodayOrders</div>
                        </div>
                        <div class="kpi-divider">|</div>
                        <div>
                            <div class="kpi-label">昨日</div>
                            <div class="kpi-value-muted">@Model.YesterdayOrders</div>
                        </div>
                        <div class="kpi-growth @(Model.OrderGrowthUp ? "text-success" : "text-danger")">
                            @if (Model.OrderGrowthRate == 0)
                            {
                                <i class="bi bi-dash"></i>
                            }
                            else
                            {
                                <i class="bi @(Model.OrderGrowthUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                            }
                            <span>@Model.OrderGrowthRate %</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 今日營收 -->
        <div class="col-xl-6 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="kpi-title">營收量</div>
                        <div class="kpi-grid">
                            <div>
                                <div class="kpi-label">今日</div>
                                <div class="kpi-value">$ @Model.TodayRevenue.ToString("N0")</div>
                            </div>
                            <div class="kpi-divider">|</div>
                            <div>
                                <div class="kpi-label">昨日</div>
                                <div class="kpi-value-muted">$ @Model.YesterdayRevenue.ToString("N0")</div>
                            </div>
                            <div class="kpi-growth @(Model.RevenueGrowthUp ? "text-success" : "text-danger" )">
                                @if (Model.RevenueGrowthRate == 0)
                                {
                                    <i class="bi bi-dash"></i>
                                }
                                else
                                {
                                    <i class="bi @(Model.RevenueGrowthUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                }
                                <span>@Model.RevenueGrowthRate %</span>
                            </div>
                        </div>
                </div>
            </div>
        </div>

        <!-- 今日新增會員 -->
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="kpi-title">會員增長</div>
                    <div class="kpi-grid">
                        <div>
                            <div class="kpi-label">今日</div>
                            <div class="kpi-value">@Model.TodayMembers</div>
                        </div>
                        <div class="kpi-divider">|</div>
                        <div>
                            <div class="kpi-label">昨日</div>
                            <div class="kpi-value-muted">@Model.YesterdayMembers</div>
                        </div>
                        <div class="kpi-growth @(Model.MemberGrowthUp ? "text-success" : "text-danger")">
                            @if (Model.MemberGrowthRate == 0)
                            {
                                <i class="bi bi-dash"></i>
                            }
                            else
                            {
                                <i class="bi @(Model.MemberGrowthUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                            }
                            <span>@Model.MemberGrowthRate %</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- ================= 圖表控制區 ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">

                <!-- 區間切換 -->
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-primary active" data-range="month">
                        本月
                    </button>
                    <button class="btn btn-outline-primary" data-range="7">
                        近7天
                    </button>
                    <button class="btn btn-outline-primary" data-range="30">
                        近30天
                    </button>
                </div>

                <!-- 歷史月份查詢 -->
                <div class="d-flex align-items-center">
                    <label class="me-2 fw-semibold">歷史月份：</label>
                    <select id="historyMonthSelect"
                            class="form-select form-select-sm"
                            style="width: 160px;">
                        <option value="">請選擇月份</option>
                        @foreach (var month in Model.AvailableMonths)
                        {
                            <option value="@month">@month</option>
                        }
                    </select>
                </div>

            </div>

            <!-- 圖表 -->

                    <div class="chart-title">交易趨勢</div>
                    <canvas id="transactionChart" height="100"></canvas>

                    <hr class="my-4" />

                    <div class="chart-title">新增會員趨勢</div>
                    <canvas id="memberChart" height="80"></canvas>

        </div>
    </div>
</div>



@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin/dashboard.js"></script>

}