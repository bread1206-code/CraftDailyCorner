@model CraftDailyCorner.Areas.Admin.ViewModels.VMDashboard

@{
    ViewData["Title"] = "儀表板";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- ================= KPI 區 ================= -->
    <div class="row g-4 mb-4">

        <!-- 今日訂單 -->
        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="small text-muted">今日訂單數</div>
                    <div class="d-flex align-items-end justify-content-between">
                        <div class="fs-3 fw-bold">@Model.TodayOrders</div>
                        <div class="text-end">
                            <div class="fw-bold @(Model.OrderGrowthUp ? "text-success" : "text-danger")">
                                <i class="bi @(Model.OrderGrowthUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                @Model.OrderGrowthRate %
                            </div>
                            <div class="small text-muted">
                                vs 昨日
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 今日營收 -->
        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="small text-muted">今日營收</div>
                    <div class="d-flex align-items-end justify-content-between">
                        <div class="fs-3 fw-bold">
                            $ @Model.TodayRevenue.ToString("N0")
                        </div>
                        <div class="text-end">
                            <div class="fw-bold @(Model.RevenueGrowthUp ? "text-success" : "text-danger")">
                                <i class="bi @(Model.RevenueGrowthUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                @Model.RevenueGrowthRate %
                            </div>
                            <div class="small text-muted">
                                vs 昨日
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 今日新增會員 -->
        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="small text-muted">今日新增會員</div>
                    <div class="d-flex align-items-end justify-content-between">
                        <div class="fs-3 fw-bold">@Model.TodayMembers</div>
                        <div class="text-end">
                            <div class="fw-bold @(Model.MemberGrowthUp ? "text-success" : "text-danger")">
                                <i class="bi @(Model.MemberGrowthUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                @Model.MemberGrowthRate %
                            </div>
                            <div class="small text-muted">
                                vs 昨日
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- ================= 圖表控制區 ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">

                <!-- 區間切換 -->
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-primary active" data-range="month">
                        本月
                    </button>
                    <button class="btn btn-outline-primary" data-range="7">
                        近7天
                    </button>
                    <button class="btn btn-outline-primary" data-range="30">
                        近30天
                    </button>
                </div>

                <!-- 歷史月份查詢 -->
                <div class="d-flex align-items-center">
                    <label class="me-2 fw-semibold">歷史月份：</label>
                    <select id="historyMonthSelect"
                            class="form-select form-select-sm"
                            style="width: 160px;">
                        <option value="">請選擇月份</option>
                        @foreach (var month in Model.AvailableMonths)
                        {
                            <option value="@month">@month</option>
                        }
                    </select>
                </div>

            </div>

            <!-- 圖表 -->
            <canvas id="dashboardChart" height="120"></canvas>

        </div>
    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin/dashboard.js"></script>

}