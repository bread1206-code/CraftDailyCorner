@model CraftDailyCorner.Areas.Admin.ViewModels.Tag.VMAdminTagEdit

@{
    ViewData["Title"] = "新增標籤";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">新增標籤</h2>
            <div class="text-light opacity-75">建立新的標籤（預設啟用）</div>
        </div>

        <a class="btn btn-outline-secondary"
           asp-area="Admin"
           asp-controller="Tag"
           asp-action="Index">
            返回列表
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-area="Admin" asp-controller="Tag" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="TagName" class="form-label text-light"></label>
                    <input asp-for="TagName"
                           class="form-control bg-dark text-light border-secondary"
                           placeholder="例如：木作、皮革、手作禮物" />
                    <span asp-validation-for="TagName" class="text-warning small"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-warning small mb-3"></div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2-circle me-1"></i> 送出新增
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}