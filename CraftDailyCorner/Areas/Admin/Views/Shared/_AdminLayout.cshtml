@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>CraftDailyCorner | 管理後台</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<body>

    <div class="d-flex admin-wrapper">

        <!-- Sidebar -->
        @await Component.InvokeAsync("VCAdminSidebar")

        <!-- Main Content -->
        <div class="admin-content flex-fill">

            <!-- Topbar -->
            <div class="admin-topbar d-flex justify-content-between align-items-center px-4 py-2 border-bottom">

                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>

                <div>
                    <span class="me-3">
                        <i class="bi bi-person-circle"></i>
                        @User.Identity?.Name
                    </span>

                    <a asp-area=""
                       asp-controller="Home" 
                       asp-action="Index" 
                       class="btn btn-sm btn-outline-secondary">
                        回前台
                    </a>
                </div>

            </div>

            <!-- Body -->
            <div class="p-4">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/admin/sidebar.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>