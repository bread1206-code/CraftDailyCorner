@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>CraftDailyCorner | 管理後台</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<body class="admin-dark">

    <div class="d-flex admin-wrapper">

        @await Component.InvokeAsync("VCAdminSidebar")

        <div class="admin-content flex-fill">

            <div class="admin-topbar d-flex justify-content-between align-items-center px-4 py-3 border-bottom">

                <h5 class="mb-0 text-light">@ViewData["Title"]</h5>

                <div class="d-flex align-items-center gap-3 text-light">
                    <span>
                        <i class="bi bi-person-circle"></i>
                        @User.Identity?.Name
                    </span>

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-light">
                        回前台
                    </a>
                </div>
            </div>

            <div class="p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/sidebar.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>