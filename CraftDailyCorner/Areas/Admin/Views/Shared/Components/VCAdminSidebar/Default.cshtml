@model CraftDailyCorner.Areas.Admin.ViewModels.VMAdminSidebar

<div class="admin-sidebar p-3">

    <ul class="nav flex-column">

        <li class="nav-item mb-3">
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link text-light">
                <i class="bi bi-speedometer2 me-2"></i>
                儀表板
            </a>
        </li>

        <!-- 創作者審核：待審核 -->
        <li class="nav-item mb-1">
            <a asp-area="Admin"
               asp-controller="CreatorReview"
               asp-action="Index"
               class="nav-link text-light d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-person-check me-2"></i>
                    創作者審核
                </span>
                <span id="badgeCreators"
                      class="badge bg-danger @(Model.PendingCreators == 0 ? "d-none" : "")">
                    @Model.PendingCreators
                </span>
            </a>
        </li>

        <!-- ✅ 新增：歷史資料入口（字體更小） -->
        <li class="nav-item mb-3 ms-4">
            <a asp-area="Admin"
               asp-controller="CreatorReview"
               asp-action="Index"
               asp-route-mode="history"
               class="nav-link text-light small opacity-75 py-1">
                查看歷史資料
            </a>
        </li>

        <li class="nav-item mb-3">
            <a asp-area="Admin"
               asp-controller="Violation"
               asp-action="Index"
               class="nav-link text-light d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    違規管理
                </span>
                <span id="badgeViolations"
                      class="badge bg-danger @(Model.PendingViolations == 0 ? "d-none" : "")">
                    @Model.PendingViolations
                </span>
            </a>
        </li>

        <li class="nav-item mb-3">
            <a class="nav-link text-light"
               asp-area="Admin"
               asp-controller="Category"
               asp-action="Index">
                <i class="bi bi-tags me-2"></i> 分類管理
            </a>
        </li>

        <li class="nav-item mb-3">
            <a class="nav-link text-light"
               asp-area="Admin"
               asp-controller="Announcement"
               asp-action="Index">
                <i class="bi bi-megaphone me-2"></i> 平台公告
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-light"
               asp-area="Admin"
               asp-controller="SystemSetting"
               asp-action="Index">
                <i class="bi bi-gear me-2"></i> 系統設定
            </a>
        </li>

    </ul>

</div>