@model CraftDailyCorner.Areas.Admin.ViewModels.HomepageBanner.VMAdminHomepageBannerIndex

@{
    ViewData["Title"] = "首頁輪播圖管理";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    @if (TempData["HomepageBannerSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["HomepageBannerSuccess"]</div>
    }

    @if (TempData["HomepageBannerWarning"] != null)
    {
        <div class="alert alert-warning">@TempData["HomepageBannerWarning"]</div>
    }

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">首頁輪播圖管理</h2>
            <div class="text-light opacity-75">新增 / 編輯 / 啟用與停用首頁輪播圖片</div>
        </div>

        <a class="btn btn-primary"
           asp-area="Admin"
           asp-controller="HomepageBanner"
           asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i> 新增輪播圖
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="p-4 text-center text-light opacity-75">
                    <i class="bi bi-images fs-2"></i>
                    <div class="mt-2">目前尚無首頁輪播圖資料</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:100px;">BannerID</th>
                                <th style="width:220px;">圖片</th>
                                <th>標題 / 副標題</th>
                                <th style="width:120px;">狀態</th>
                                <th style="width:180px;">建立時間</th>
                                <th style="width:160px;">建立者</th>
                                <th style="width:220px;" class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Items)
                            {
                                var isActive = x.StatusID == 1;
                                var badgeClass = isActive ? "bg-success" : "bg-secondary";
                                var btnText = isActive ? "停用" : "啟用";
                                var btnClass = isActive ? "btn-outline-warning" : "btn-outline-success";
                                var btnAction = isActive ? "Disable" : "Enable";
                                var confirmText = isActive ? "確定要停用這張首頁輪播圖嗎？" : "確定要啟用這張首頁輪播圖嗎？";

                                <tr class="@(isActive ? "" : "table-secondary")">
                                    <td>#@x.BannerID</td>

                                    <td>
                                        <img src="@($"/Photos/08HomepageBanner/Other/{x.ImageUrl}.png")"
                                             alt="Banner 圖片"
                                             class="rounded border"
                                             style="width:180px;height:90px;object-fit:cover;" />
                                    </td>

                                    <td>
                                        <div class="fw-semibold">@x.Title</div>

                                        @if (!string.IsNullOrWhiteSpace(x.Subtitle))
                                        {
                                            <div class="small text-light opacity-75 mt-1">
                                                @x.Subtitle
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-light opacity-50 mt-1">
                                                （無副標題）
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge @badgeClass">
                                            @x.StatusName
                                        </span>
                                    </td>

                                    <td>
                                        @x.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td>
                                        <div>@(x.CreatedByName ?? "—")</div>
                                        <div class="small text-light opacity-75">@x.CreatedBy</div>
                                    </td>

                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-light"
                                           asp-area="Admin"
                                           asp-controller="HomepageBanner"
                                           asp-action="Edit"
                                           asp-route-id="@x.BannerID">
                                            編輯
                                        </a>

                                        <form class="d-inline"
                                              asp-area="Admin"
                                              asp-controller="HomepageBanner"
                                              asp-action="@btnAction"
                                              asp-route-id="@x.BannerID"
                                              method="post"
                                              onsubmit="return confirm('@confirmText');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @btnClass">
                                                @btnText
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>