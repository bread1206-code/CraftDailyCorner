@model CraftDailyCorner.Areas.Admin.ViewModels.HomepageBanner.VMAdminHomepageBannerUpsert

@{
    ViewData["Title"] = "新增首頁輪播圖";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">新增首頁輪播圖</h2>
            <div class="text-light opacity-75">上傳首頁輪播圖片並設定標題與副標題</div>
        </div>

        <a class="btn btn-outline-light"
           asp-area="Admin"
           asp-controller="HomepageBanner"
           asp-action="Index">
            返回列表
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="HomepageBanner"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row g-4">
                    <!-- 左側：表單 -->
                    <div class="col-lg-6">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label text-light"></label>
                            <input asp-for="Title"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="請輸入主標題" />
                            <span asp-validation-for="Title" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subtitle" class="form-label text-light"></label>
                            <input asp-for="Subtitle"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="請輸入副標題（可不填）" />
                            <span asp-validation-for="Subtitle" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label text-light"></label>
                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control bg-dark text-light border-secondary"
                                   accept="image/*"
                                   id="ImageFile" />
                            <span asp-validation-for="ImageFile" class="text-warning small"></span>

                            <div class="form-text text-light opacity-75 mt-2">
                                建議上傳橫幅圖片，系統會依 HomepageBanner 尺寸規則處理。
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-light">狀態</label>

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="StatusID"
                                       value="1"
                                       checked />

                                <label class="form-check-label text-light">
                                    啟用
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="StatusID"
                                       value="2" />

                                <label class="form-check-label text-light">
                                    停用
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2-circle me-1"></i> 新增
                            </button>

                            <a class="btn btn-outline-light"
                               asp-area="Admin"
                               asp-controller="HomepageBanner"
                               asp-action="Index">
                                取消
                            </a>
                        </div>
                    </div>

                    <!-- 右側：圖片預覽 -->
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100 bg-dark-subtle">
                            <div class="fw-semibold text-light mb-3">
                                <i class="bi bi-image me-2"></i>圖片預覽
                            </div>

                            <div class="ratio ratio-16x9 border rounded overflow-hidden bg-dark d-flex align-items-center justify-content-center">
                                <img id="ImagePreview"
                                     src=""
                                     alt="圖片預覽"
                                     class="w-100 h-100 d-none"
                                     style="object-fit:cover;" />

                                <div id="PreviewPlaceholder"
                                     class="text-secondary text-center px-3">
                                    <i class="bi bi-card-image fs-1 d-block mb-2"></i>
                                    尚未選擇圖片
                                </div>
                            </div>

                            <div class="text-secondary small mt-3">
                                選擇圖片後，這裡會顯示預覽效果。
                            </div>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const input = document.getElementById("ImageFile");
            const preview = document.getElementById("ImagePreview");
            const placeholder = document.getElementById("PreviewPlaceholder");

            if (!input || !preview || !placeholder) return;

            input.addEventListener("change", function () {
                const file = input.files && input.files[0];

                if (!file) {
                    preview.src = "";
                    preview.classList.add("d-none");
                    placeholder.classList.remove("d-none");
                    return;
                }

                const objectUrl = URL.createObjectURL(file);
                preview.src = objectUrl;
                preview.classList.remove("d-none");
                placeholder.classList.add("d-none");
            });
        })();
    </script>
}