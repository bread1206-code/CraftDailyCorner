@using CraftDailyCorner.Extensions
@model CraftDailyCorner.Areas.Admin.ViewModels.Member.VMAdminMemberDetail

@functions {
    public string MaskEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email) || !email.Contains("@"))
            return "（未提供）";

        var parts = email.Split('@');
        var name = parts[0];
        var domain = parts[1];

        if (name.Length <= 2)
            return $"{name[0]}***@{domain}";

        return $"{name.Substring(0, 2)}***@{domain}";
    }

    public string MaskPhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return "（未提供）";

        var trimmed = phone.Trim();
        if (trimmed.Length <= 4)
            return "***";

        return $"{trimmed.Substring(0, 2)}***{trimmed.Substring(trimmed.Length - 2)}";
    }
}

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var mode = Context.Request.Query["mode"].ToString();
    var currentMemberId = User.GetMemberId();
    var isSelf = Model.MemberID == currentMemberId;
    var isSuperAdmin = Model.RoleIDs.Contains("04");

    var hasCreatorProfile = !string.IsNullOrWhiteSpace(Model.CreatorID);
}

<div class="container-fluid">

    @if (TempData["MembersSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["MembersSuccess"]</div>
    }
    @if (TempData["MembersWarning"] != null)
    {
        <div class="alert alert-warning">@TempData["MembersWarning"]</div>
    }

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">會員詳情</h2>
            <div class="text-secondary">@Model.MemberID</div>
        </div>

        <a class="btn btn-outline-secondary"
           asp-area="Admin"
           asp-controller="Members"
           asp-action="Index"
           asp-route-mode="@mode">
            返回列表
        </a>
    </div>

    <div class="row g-4">

        <!-- 左側 -->
        <div class="col-lg-7">

            <!-- 基本資訊 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="fw-semibold text-light">
                            <i class="bi bi-person-badge me-2"></i>會員基本資訊
                        </div>

                        @if (Model.StatusID == 1)
                        {
                            <span class="badge bg-success">啟用中</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">停權中</span>
                        }
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.MemberID)</div>
                            <div class="text-light fw-semibold">@Model.MemberID</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.DisplayName)</div>
                            <div class="text-light fw-semibold">@Model.DisplayName</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.StatusName)</div>
                            <div class="text-light">@Model.StatusName</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.CreatedAt)</div>
                            <div class="text-light">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                        </div>

                        <div class="col-12">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.Email)</div>
                            <div class="text-light">@MaskEmail(Model.Email)</div>
                            <div class="text-secondary small mt-1">※ 為保護隱私，已遮罩顯示</div>
                        </div>

                        <div class="col-12">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.Phone)</div>
                            <div class="text-light">@MaskPhone(Model.Phone)</div>
                            <div class="text-secondary small mt-1">※ 為保護隱私，已遮罩顯示</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 創作者資訊 -->
            @if (hasCreatorProfile)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="fw-semibold text-light">
                                <i class="bi bi-palette me-2"></i>創作者資訊
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.CreatorStatusName))
                            {
                                <span class="badge bg-info text-dark">@Model.CreatorStatusName</span>
                            }
                        </div>

                        <hr />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.CreatorID)</div>
                                <div class="text-light fw-semibold">@Model.CreatorID</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.CreatorStatusName)</div>
                                <div class="text-light">@((Model.CreatorStatusName ?? "（未提供）"))</div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.BrandName)</div>
                                <div class="text-light fw-semibold">@((Model.BrandName ?? "（未提供）"))</div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.BrandIntro)</div>
                                <div class="text-light" style="white-space:pre-wrap;">@(Model.BrandIntro ?? "（未提供）")</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.StartDate)</div>
                                <div class="text-light">
                                    @(Model.StartDate.HasValue
                                                                    ? Model.StartDate.Value.ToString("yyyy/MM/dd")
                                                                    : "（未提供）")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.CreatorCreatedAt)</div>
                                <div class="text-light">
                                    @(Model.CreatorCreatedAt.HasValue
                                                                    ? Model.CreatorCreatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                                                    : "（未提供）")
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.UpdatedAt)</div>
                                <div class="text-light">
                                    @(Model.UpdatedAt.HasValue
                                                                    ? Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                                                    : "（未提供）")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- 右側 -->
        <div class="col-lg-5">

            <!-- 角色資訊 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="fw-semibold text-light mb-3">
                        <i class="bi bi-shield-lock me-2"></i>角色資訊
                    </div>

                    <hr />

                    @if (Model.RoleNames.Any())
                    {
                        <div class="mb-2">
                            @for (int i = 0; i < Model.RoleNames.Count; i++)
                            {
                                var roleId = Model.RoleIDs[i];
                                var badgeClass = roleId switch
                                {
                                                "01" => "bg-primary",
                                                "02" => "bg-success",
                                                "03" => "bg-warning text-dark",
                                                "04" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <span class="badge @badgeClass me-2 mb-2 px-3 py-2">
                                    @Model.RoleNames[i]
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">沒有角色資料</div>
                    }
                </div>
            </div>

            <!-- 風險資訊 -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="fw-semibold text-light mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>風險資訊
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.ViolationCount)</div>
                            <div class="text-light fw-semibold fs-5">@Model.ViolationCount</div>
                        </div>

                        <div class="col-12">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.MaliciousReportCount)</div>
                            <div class="text-light fw-semibold fs-5">@Model.MaliciousReportCount</div>
                        </div>

                        <div class="col-12">
                            <div class="text-secondary small mb-1">@Html.DisplayNameFor(m => m.ReportBanUntil)</div>
                            <div class="text-light">
                                @(Model.ReportBanUntil.HasValue
                                                                ? Model.ReportBanUntil.Value.ToString("yyyy/MM/dd HH:mm")
                                                                : "（無）")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 帳號操作 -->
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="fw-semibold text-light mb-3">
                        <i class="bi bi-person-slash me-2"></i>帳號操作
                    </div>

                    <hr />

                    @if (isSelf)
                    {
                        <div class="alert alert-warning mb-3">
                            你不能停權自己的帳號。
                        </div>

                        <button class="btn btn-outline-secondary w-100" disabled>
                            不可停權自己
                        </button>
                    }
                    else if (isSuperAdmin)
                    {
                        <div class="alert alert-danger mb-3">
                            超級管理者帳號不可停權。
                        </div>

                        <button class="btn btn-outline-danger w-100" disabled>
                            超級管理者不可停權
                        </button>
                    }
                    else if (Model.StatusID == 1)
                    {
                        <form asp-area="Admin"
                              asp-controller="Members"
                              asp-action="Suspend"
                              asp-route-id="@Model.MemberID"
                              asp-route-mode="@mode"
                              method="post"
                              onsubmit="return confirm('確定要停權這位會員嗎？');">

                            @Html.AntiForgeryToken()

                            <button class="btn btn-outline-warning w-100">
                                <i class="bi bi-pause-circle me-1"></i> 停權會員
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-area="Admin"
                              asp-controller="Members"
                              asp-action="Activate"
                              asp-route-id="@Model.MemberID"
                              asp-route-mode="@mode"
                              method="post"
                              onsubmit="return confirm('確定要恢復這位會員嗎？');">

                            @Html.AntiForgeryToken()

                            <button class="btn btn-outline-success w-100">
                                <i class="bi bi-check2-circle me-1"></i> 恢復啟用
                            </button>
                        </form>
                    }
                </div>
            </div>

        </div>
    </div>
</div>